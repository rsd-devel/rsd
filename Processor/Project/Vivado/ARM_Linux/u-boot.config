# Use the 2019.2 FSBL and embed the control DTB in the ELF loaded by bootgen.
# CONFIG_SPL is not set
# CONFIG_OF_BOARD is not set
# CONFIG_OF_SEPARATE is not set
CONFIG_OF_EMBED=y
CONFIG_DEFAULT_DEVICE_TREE="zynq-zed"
CONFIG_BOOTCOMMAND="run distro_bootcmd"
# Ignore any environment left in the board's flash by older installations.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_NAND is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
# CONFIG_SYS_REDUNDAND_ENVIRONMENT is not set
# EFI capsule updates select the stock DFU map, which assumes an SPL payload.
# This SD image uses FSBL and is updated by regenerating the image.
# CONFIG_EFI_CAPSULE_FIRMWARE_MANAGEMENT is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set
# CONFIG_SET_DFU_ALT_INFO is not set
