package DebugTypes {
    import BasicTypes::*;
    import MemoryMapTypes::*;
    import OpFormatTypes::*;
    import MicroOpTypes::*;
    import RenameLogicTypes::*;
    import SchedulerTypes::*;
    import ActiveListIndexTypes::*;
    import LoadStoreUnitTypes::*;
    import PipelineTypes::*;

    type ComplexExecOpIdArray = OpId [COMPLEX_EXEC_STAGE_DEPTH];
    type FPExecOpIdArray = OpId [FP_EXEC_STAGE_DEPTH];

    // --- Hardware Counter
    struct PerfCounterPath {
        numIC_Miss: DataPath,
        numLoadMiss: DataPath,
        numStoreMiss: DataPath,
        numBranchPredMiss: DataPath,
        numBranchPredMissDetectedOnDecode: DataPath,
        numStoreLoadForwardingFail: DataPath,
        numMemDepPredMiss: DataPath,
    }

    // --- Debug Register
    struct NextPCStageDebugRegister { valid: logic, sid: OpSerial, }
    struct FetchStageDebugRegister { valid: logic, sid: OpSerial, flush: logic, icMiss: logic, }

    struct PreDecodeStageDebugRegister {
        valid: logic,
        sid: OpSerial,
        // 演算のソースと結果の値は、機能シミュレーション時のみデバッグ出力する
        // 合成時は、IOポートが足りなくて不可能であるため
        aluCode: IntALU_Code,
        opType: IntMicroOpSubType,
    }

    struct DecodeStageDebugRegister {
        valid: logic,
        // Branch misprediction is detected on instruction decode and flush this instruction.
        flushed: logic,
        // This op causes branch misprediction and triggers flush.
        flushTriggering: logic,
        opId: OpId,
        pc: AddrPath,
        insn: InsnPath,
        undefined: logic,
        unsupported: logic,
    }

    // Physical register numbers are outputted in the next stage, because
    // The pop flags of the free list is negated and correct physical
    // register numbers cannot be outputted in this stage when the pipeline
    // is stalled.
    struct RenameStageDebugRegister { valid: logic, opId: OpId, }

    struct DispatchStageDebugRegister {
        valid: logic,
        opId: OpId,
        // レジスタ番号は、機能シミュレーション時のみデバッグ出力する
        // 合成時は、IOポートが足りなくて不可能であるため
        readRegA: logic,
        logSrcRegA: LRegNumPath,
        phySrcRegA: PRegNumPath,
        readRegB: logic,
        logSrcRegB: LRegNumPath,
        phySrcRegB: PRegNumPath,
        readRegC: logic,
        logSrcRegC: LRegNumPath,
        phySrcRegC: PRegNumPath,
        writeReg: logic,
        logDstReg: LRegNumPath,
        phyDstReg: PRegNumPath,
        phyPrevDstReg: PRegNumPath,
        activeListPtr: ActiveListIndexPath,
        issueQueuePtr: IssueQueueIndexPath,
    }

    struct IntegerIssueStageDebugRegister { valid: logic, flush: logic, opId: OpId, }
    struct IntegerRegisterReadStageDebugRegister { valid: logic, flush: logic, opId: OpId, }

    struct IntegerExecutionStageDebugRegister {
        valid: logic,
        flush: logic,
        opId: OpId,
        // Output source values and an execution result only on functional simulation
        // because actual chips do not have enough IO pins for these signals.
        dataOut: DataPath,
        fuOpA: DataPath,
        fuOpB: DataPath,
        aluCode: IntALU_Code,
        opType: IntMicroOpSubType,
        brPredMiss: logic,
    }

    struct IntegerRegisterWriteStageDebugRegister { valid: logic, flush: logic, opId: OpId, }
    struct ComplexIntegerIssueStageDebugRegister { valid: logic, flush: logic, opId: OpId, }
    struct ComplexIntegerRegisterReadStageDebugRegister { valid: logic, flush: logic, opId: OpId, }

    struct ComplexIntegerExecutionStageDebugRegister {
        valid: logic<COMPLEX_EXEC_STAGE_DEPTH>,
        flush: logic<COMPLEX_EXEC_STAGE_DEPTH>,
        opId: ComplexExecOpIdArray,
        // 演算のソースと結果の値は、機能シミュレーション時のみデバッグ出力する
        // 合成時は、IOポートが足りなくて不可能であるため
        dataOut: DataPath,
        fuOpA: DataPath,
        fuOpB: DataPath,
    }

    struct ComplexIntegerRegisterWriteStageDebugRegister { valid: logic, flush: logic, opId: OpId, }
    struct MemoryIssueStageDebugRegister { valid: logic, flush: logic, opId: OpId, }
    struct MemoryRegisterReadStageDebugRegister { valid: logic, flush: logic, opId: OpId, }

    struct MemoryExecutionStageDebugRegister {
        valid: logic,
        flush: logic,
        opId: OpId,
        // 演算のソースと結果の値は、機能シミュレーション時のみデバッグ出力する
        // 合成時は、IOポートが足りなくて不可能であるため
        addrOut: AddrPath,
        fuOpA: DataPath,
        fuOpB: DataPath,
        opType: MemMicroOpSubType,
        size: MemAccessSizeType,
        isSigned: logic,
    }

    struct MemoryTagAccessStageDebugRegister {
        valid: logic,
        flush: logic,
        opId: OpId,
        executeLoad: logic,
        executedLoadAddr: AddrPath,
        mshrAllocated: logic,
        mshrHit: logic,
        mshrEntryID: DataPath,
        executeStore: logic,
        executedStoreAddr: AddrPath,
        executedStoreData: DataPath,
        executedStoreVectorData: VectorPath,
    }

    struct MemoryAccessStageDebugRegister {
        valid: logic,
        flush: logic,
        opId: OpId,
        executeLoad: logic,
        executedLoadData: DataPath,
        executedLoadVectorData: VectorPath,
    }

    struct MemoryRegisterWriteStageDebugRegister { valid: logic, flush: logic, opId: OpId, }
    struct FPIssueStageDebugRegister { valid: logic, flush: logic, opId: OpId, }
    struct FPRegisterReadStageDebugRegister { valid: logic, flush: logic, opId: OpId, }

    struct FPExecutionStageDebugRegister {
        valid: logic<FP_EXEC_STAGE_DEPTH>,
        flush: logic<FP_EXEC_STAGE_DEPTH>,
        opId: FPExecOpIdArray,
        // 演算のソースと結果の値は、機能シミュレーション時のみデバッグ出力する
        // 合成時は、IOポートが足りなくて不可能であるため
        dataOut: DataPath,
        fuOpA: DataPath,
        fuOpB: DataPath,
        fuOpC: DataPath,
    }

    struct FPRegisterWriteStageDebugRegister { valid: logic, flush: logic, opId: OpId, }

    struct CommitStageDebugRegister {
        commit: logic,
        flush: logic,
        opId: OpId,
        releaseReg: logic,
        phyReleasedReg: PRegNumPath,
    }

    struct ActiveListDebugRegister { finished: logic, opId: OpId, }
    struct SchedulerDebugRegister { valid: logic, }
    struct IssueQueueDebugRegister { flush: logic, opId: OpId, }

    type NextPCStageDebugRegisterArray = NextPCStageDebugRegister [FETCH_WIDTH];
    type FetchStageDebugRegisterArray = FetchStageDebugRegister [FETCH_WIDTH];
    type PreDecodeStageDebugRegisterArray = PreDecodeStageDebugRegister [DECODE_WIDTH];
    type DecodeStageDebugRegisterArray = DecodeStageDebugRegister [DECODE_WIDTH];
    type RenameStageDebugRegisterArray = RenameStageDebugRegister [RENAME_WIDTH];
    type DispatchStageDebugRegisterArray = DispatchStageDebugRegister [DISPATCH_WIDTH];
    type IntegerIssueStageDebugRegisterArray = IntegerIssueStageDebugRegister [INT_ISSUE_WIDTH];
    type IntegerRegisterReadStageDebugRegisterArray = IntegerRegisterReadStageDebugRegister [INT_ISSUE_WIDTH];
    type IntegerExecutionStageDebugRegisterArray = IntegerExecutionStageDebugRegister [INT_ISSUE_WIDTH];
    type IntegerRegisterWriteStageDebugRegisterArray = IntegerRegisterWriteStageDebugRegister [INT_ISSUE_WIDTH];
    type ComplexIntegerIssueStageDebugRegisterArray = ComplexIntegerIssueStageDebugRegister [COMPLEX_ISSUE_WIDTH];
    type ComplexIntegerRegisterReadStageDebugRegisterArray = ComplexIntegerRegisterReadStageDebugRegister [COMPLEX_ISSUE_WIDTH];
    type ComplexIntegerExecutionStageDebugRegisterArray = ComplexIntegerExecutionStageDebugRegister [COMPLEX_ISSUE_WIDTH];
    type ComplexIntegerRegisterWriteStageDebugRegisterArray = ComplexIntegerRegisterWriteStageDebugRegister [COMPLEX_ISSUE_WIDTH];
    type MemoryIssueStageDebugRegisterArray = MemoryIssueStageDebugRegister [MEM_ISSUE_WIDTH];
    type MemoryRegisterReadStageDebugRegisterArray = MemoryRegisterReadStageDebugRegister [MEM_ISSUE_WIDTH];
    type MemoryExecutionStageDebugRegisterArray = MemoryExecutionStageDebugRegister [MEM_ISSUE_WIDTH];
    type MemoryTagAccessStageDebugRegisterArray = MemoryTagAccessStageDebugRegister [MEM_ISSUE_WIDTH];
    type MemoryAccessStageDebugRegisterArray = MemoryAccessStageDebugRegister [MEM_ISSUE_WIDTH];
    type MemoryRegisterWriteStageDebugRegisterArray = MemoryRegisterWriteStageDebugRegister [MEM_ISSUE_WIDTH];
    type FPIssueStageDebugRegisterArray = FPIssueStageDebugRegister [FP_ISSUE_WIDTH];
    type FPRegisterReadStageDebugRegisterArray = FPRegisterReadStageDebugRegister [FP_ISSUE_WIDTH];
    type FPExecutionStageDebugRegisterArray = FPExecutionStageDebugRegister [FP_ISSUE_WIDTH];
    type FPRegisterWriteStageDebugRegisterArray = FPRegisterWriteStageDebugRegister [FP_ISSUE_WIDTH];
    type CommitStageDebugRegisterArray = CommitStageDebugRegister [COMMIT_WIDTH];
    type SchedulerDebugRegisterArray = SchedulerDebugRegister [ISSUE_QUEUE_ENTRY_NUM];
    type IssueQueueDebugRegisterArray = IssueQueueDebugRegister [ISSUE_QUEUE_ENTRY_NUM];

    struct DebugRegister {
        // DebugRegister of each stage
        npReg: NextPCStageDebugRegisterArray,
        ifReg: FetchStageDebugRegisterArray,
        pdReg: PreDecodeStageDebugRegisterArray,
        idReg: DecodeStageDebugRegisterArray,
        rnReg: RenameStageDebugRegisterArray,
        dsReg: DispatchStageDebugRegisterArray,
        intIsReg: IntegerIssueStageDebugRegisterArray,
        intRrReg: IntegerRegisterReadStageDebugRegisterArray,
        intExReg: IntegerExecutionStageDebugRegisterArray,
        intRwReg: IntegerRegisterWriteStageDebugRegisterArray,
        complexIsReg: ComplexIntegerIssueStageDebugRegisterArray,
        complexRrReg: ComplexIntegerRegisterReadStageDebugRegisterArray,
        complexExReg: ComplexIntegerExecutionStageDebugRegisterArray,
        complexRwReg: ComplexIntegerRegisterWriteStageDebugRegisterArray,
        memIsReg: MemoryIssueStageDebugRegisterArray,
        memRrReg: MemoryRegisterReadStageDebugRegisterArray,
        memExReg: MemoryExecutionStageDebugRegisterArray,
        mtReg: MemoryTagAccessStageDebugRegisterArray,
        maReg: MemoryAccessStageDebugRegisterArray,
        memRwReg: MemoryRegisterWriteStageDebugRegisterArray,
        fpIsReg: FPIssueStageDebugRegisterArray,
        fpRrReg: FPRegisterReadStageDebugRegisterArray,
        fpExReg: FPExecutionStageDebugRegisterArray,
        fpRwReg: FPRegisterWriteStageDebugRegisterArray,
        cmReg: CommitStageDebugRegisterArray,
        scheduler: SchedulerDebugRegisterArray,
        issueQueue: IssueQueueDebugRegisterArray,
        // Signals related to commit
        toRecoveryPhase: logic,
        activeListHeadPtr: ActiveListIndexPath,
        activeListCount: ActiveListCountPath,
        // Pipeline control signal
        npStagePipeCtrl: PipelineControll,
        ifStagePipeCtrl: PipelineControll,
        pdStagePipeCtrl: PipelineControll,
        idStagePipeCtrl: PipelineControll,
        rnStagePipeCtrl: PipelineControll,
        dsStagePipeCtrl: PipelineControll,
        backEndPipeCtrl: PipelineControll,
        cmStagePipeCtrl: PipelineControll,
        stallByDecodeStage: logic,
        // Others
        loadStoreUnitAllocatable: logic,
        storeCommitterPhase: logic,
        storeQueueCount: StoreQueueCountPath,
        busyInRecovery: logic,
        storeQueueEmpty: logic,
        // Performance monitoring counters are exported to DebugRegister only on simulation.
        perfCounter: PerfCounterPath,
    }
}
