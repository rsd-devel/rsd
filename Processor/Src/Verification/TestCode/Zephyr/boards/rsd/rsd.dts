/dts-v1/;

/ {
	model = "RSD simulation";
	compatible = "rsd";
	#address-cells = <1>;
	#size-cells = <1>;

	chosen {
		zephyr,sram = &ram;
		zephyr,flash = &rom;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		cpu@0 {
			device_type = "cpu";
			compatible = "riscv";
			reg = <0>;
			clock-frequency = <50000000>;
			riscv,isa-base = "rv32i";
			riscv,isa-extensions = "i", "m", "a", "zicsr", "zifencei";

			hlic: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#address-cells = <0>;
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};
	};

	ram: memory@80000000 {
		compatible = "mmio-sram";
		reg = <0x80000000 0x40000>;
	};

	rom: flash@1000 {
		compatible = "soc-nv-flash";
		reg = <0x1000 0xf000>;
	};

	mtimer: timer@40017ff8 {
		compatible = "riscv,machine-timer";
		reg = <0x40017ff8 8 0x40014000 8>;
		reg-names = "mtime", "mtimecmp";
		interrupts-extended = <&hlic 7>;
	};
};
