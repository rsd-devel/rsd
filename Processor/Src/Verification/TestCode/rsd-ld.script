OUTPUT_FORMAT("elf32-littleriscv");
OUTPUT_ARCH("riscv")

/* エントリポイント．_start は rsd-crt.s で定義 */
ENTRY(_start);


INCLUDE rsd-memory-map.ld

/* Keep the small-program limits independent of the hardware capacity. */
MEMORY {
    ROM(rxai) :     ORIGIN = RSD_ROM_BASE, LENGTH = MIN(RSD_ROM_SIZE, 32k)
    RAM(wa) :       ORIGIN = RSD_RAM_BASE, LENGTH = MIN(RSD_RAM_SIZE, 32k)
}

SECTIONS
{
    .text : { *(.text) }     > ROM
    .rodata : { *(.rodata) } > ROM
    .srodata : { *(.srodata) } > ROM
    /* Align the RAM and ROM starts for the loader's word-copy fast path. */
    .data : ALIGN(4) {
      __data_start = .;
      *(.data)
      *(.sdata)
      __data_end = .;
    } > RAM  AT> ROM
    __data_load_start = LOADADDR(.data);
    .bss : ALIGN(4) {
      __bss_start = .;
      *(.bss)
      *(.sbss)
      __bss_end = . ;
    } > RAM AT> ROM
    
    .comment : { *(.comment) } > ROM
}

ASSERT(RSD_RESET_VECTOR == ORIGIN(ROM), "Startup must begin at the reset vector")
