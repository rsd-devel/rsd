module Controller (
    port : modport ControllerIF::Controller,
    debug: modport DebugIF::Controller,
) {
    import BasicTypes::*;
    import PipelineTypes::*;
    import DebugTypes::*;

    var npStage : PipelineControll;
    var ifStage : PipelineControll;
    var pdStage : PipelineControll;
    var idStage : PipelineControll;
    var rnStage : PipelineControll;
    var dsStage : PipelineControll;
    var scStage : PipelineControll;
    var isStage : PipelineControll;
    var backEnd : PipelineControll;
    var cmStage : PipelineControll;
    var stallByDecodeStage: logic;

    always_comb {
        //
        // See comments in ControllerIF for stall/clear
        //

        stallByDecodeStage = FALSE;

        //
        // --- Front-end control
        //
        if port.rst {
            // リセット時にパイプラインラッチに無効化フラグを書くため，stall はFALSE に
            //              stall/ clear
            npStage.stall = FALSE;
            npStage.clear = TRUE;
            ifStage.stall = FALSE;
            ifStage.clear = TRUE;
            pdStage.stall = FALSE;
            pdStage.clear = TRUE;
            idStage.stall = FALSE;
            idStage.clear = TRUE;
            rnStage.stall = FALSE;
            rnStage.clear = TRUE;
            dsStage.stall = FALSE;
            dsStage.clear = TRUE;
        } else {
            //
            // 通常時
            //              stall/ clear
            npStage.stall = FALSE;
            npStage.clear = FALSE;
            ifStage.stall = FALSE;
            ifStage.clear = FALSE;
            pdStage.stall = FALSE;
            pdStage.clear = FALSE;
            idStage.stall = FALSE;
            idStage.clear = FALSE;
            rnStage.stall = FALSE;
            rnStage.clear = FALSE;
            dsStage.stall = FALSE;
            dsStage.clear = FALSE;

            if port.cmStageFlushUpper {
                //
                // A request from lower stages has a higher priority.
                //
                // Clear ops not in the active list when branch misprediction is detected.
                //              stall/ clear
                npStage.stall = FALSE;
                npStage.clear = FALSE;
                ifStage.stall = FALSE;
                ifStage.clear = TRUE;
                pdStage.stall = FALSE;
                pdStage.clear = TRUE;
                idStage.stall = FALSE;
                idStage.clear = TRUE;
                rnStage.stall = FALSE;
                rnStage.clear = TRUE;
                dsStage.stall = FALSE;
                dsStage.clear = TRUE;
            } else if port.rnStageSendBubbleLower {
                //
                // Stall and send a bubble to lower stages because there are not enough
                // physical registers
                //              stall/ clear
                npStage.stall = TRUE;
                npStage.clear = FALSE;
                ifStage.stall = TRUE;
                ifStage.clear = FALSE;
                pdStage.stall = TRUE;
                pdStage.clear = FALSE;
                idStage.stall = TRUE;
                idStage.clear = FALSE;
                rnStage.stall = TRUE;
                rnStage.clear = TRUE;
                // 後続ステージにバブル（NOP）を送る
            } else if port.rnStageFlushUpper {
                //
                // リネーマより上流をフラッシュ
                //              stall/ clear
                npStage.stall = FALSE;
                npStage.clear = FALSE;
                ifStage.stall = FALSE;
                ifStage.clear = TRUE;
                pdStage.stall = FALSE;
                pdStage.clear = TRUE;
                idStage.stall = FALSE;
                idStage.clear = TRUE;
            } else if port.idStageStallUpper {
                //
                // デコーダより上流（フェッチャ）をストール
                // マイクロOp デコードを行うためにとめているため，
                // バブルは不要
                //              stall/ clear
                npStage.stall = TRUE;
                npStage.clear = FALSE;
                ifStage.stall = TRUE;
                ifStage.clear = FALSE;
                pdStage.stall = TRUE;
                pdStage.clear = FALSE;
                idStage.stall = TRUE;
                idStage.clear = FALSE;

                stallByDecodeStage = TRUE;
            } else if port.ifStageSendBubbleLower {
                //
                // I-Cache miss.
                // Stop PC update and Send NOPs to the lower stages.
                //          stall/ clear
                npStage.stall = TRUE;
                npStage.clear = TRUE;
                ifStage.stall = TRUE;
                ifStage.clear = TRUE;
            } else if port.npStageSendBubbleLower ||
                      port.npStageSendBubbleLowerForInterrupt {
                //
                // Interrupt
                //
                npStage.stall = TRUE;
                npStage.clear = TRUE;
            }
        }

        port.npStage = npStage;
        port.ifStage = ifStage;
        port.pdStage = pdStage;
        port.idStage = idStage;
        port.rnStage = rnStage;
        port.dsStage = dsStage;
        port.stallByDecodeStage = stallByDecodeStage;

        //
        // --- Back-end control
        //
        if port.rst {
            // リセット時にパイプラインラッチに無効化フラグを書くため，stall はFALSE に
            //              stall/ clear
            scStage.stall = FALSE;
            scStage.clear = TRUE;
            isStage.stall = FALSE;
            isStage.clear = TRUE;
            backEnd.stall = FALSE;
            backEnd.clear = TRUE;
            cmStage.stall = FALSE;
            cmStage.clear = TRUE;
        } else {
            if port.isStageStallUpper {
                //
                // A request from lower stages has a higher priority.
                //
                // Stall scheduler
                scStage.stall = TRUE;
                scStage.clear = FALSE;
                isStage.stall = TRUE;
                isStage.clear = FALSE;
                backEnd.stall = FALSE;
                backEnd.clear = FALSE;
                cmStage.stall = FALSE;
                cmStage.clear = FALSE;
            } else {
                //
                // 通常時
                //              stall/ clear
                scStage.stall = FALSE;
                scStage.clear = FALSE;
                isStage.stall = FALSE;
                isStage.clear = FALSE;
                backEnd.stall = FALSE;
                backEnd.clear = FALSE;
                cmStage.stall = FALSE;
                cmStage.clear = FALSE;
            }
        }

        port.scStage = scStage;
        port.isStage = isStage;
        port.backEnd = backEnd;
        port.cmStage = cmStage;

        // パイプライン全体で生きている命令がいるかどうか
        port.wholePipelineEmpty =
            // IF は clear されない限り何か有効な命令をフェッチする
            npStage.clear &&
            port.ifStageEmpty &&
            port.pdStageEmpty &&
            port.idStageEmpty &&
            port.rnStageEmpty &&
            port.activeListEmpty;

        // Debug Register
        debug.npStagePipeCtrl = npStage;
        debug.ifStagePipeCtrl = ifStage;
        debug.pdStagePipeCtrl = pdStage;
        debug.idStagePipeCtrl = idStage;
        debug.rnStagePipeCtrl = rnStage;
        debug.dsStagePipeCtrl = dsStage;
        debug.backEndPipeCtrl = backEnd;
        debug.cmStagePipeCtrl = cmStage;
        debug.stallByDecodeStage = stallByDecodeStage;
    }
}
