interface DCacheIF {
    import BasicTypes::*;
    import CacheSystemTypes::*;
    import MemoryMapTypes::*;
    import ActiveListIndexTypes::*;

    var clk     : clock;
    var rst     : logic;
    var rstStart: logic;

    var tagArrayWE      : logic [DCACHE_ARRAY_PORT_NUM];
    var tagArrayWriteWay: DCacheWayPath [DCACHE_ARRAY_PORT_NUM];
    var tagArrayIndexIn : DCacheIndexPath [DCACHE_ARRAY_PORT_NUM];
    var tagArrayDataIn  : DCacheTagPath [DCACHE_ARRAY_PORT_NUM];
    var tagArrayValidIn : logic [DCACHE_ARRAY_PORT_NUM];
    var tagArrayDataOut : DCacheTagPath [DCACHE_WAY_NUM, DCACHE_ARRAY_PORT_NUM];
    var tagArrayValidOut: logic [DCACHE_WAY_NUM, DCACHE_ARRAY_PORT_NUM];

    var dataArrayWE                : logic [DCACHE_ARRAY_PORT_NUM];
    var dataArrayIndexIn           : DCacheIndexPath [DCACHE_ARRAY_PORT_NUM];
    var dataArrayDataIn            : DCacheLinePath [DCACHE_ARRAY_PORT_NUM];
    var dataArrayDataOut           : DCacheLinePath [DCACHE_ARRAY_PORT_NUM];
    var dataArrayByteWE_In         : DCacheByteEnablePath [DCACHE_ARRAY_PORT_NUM];
    var dataArrayWriteWay          : DCacheWayPath [DCACHE_ARRAY_PORT_NUM];
    var dataArrayReadWay           : DCacheWayPath [DCACHE_ARRAY_PORT_NUM];
    var dataArrayDoesReadEvictedWay: logic [DCACHE_ARRAY_PORT_NUM];
    var dataArrayDirtyIn           : logic [DCACHE_ARRAY_PORT_NUM];
    var dataArrayDirtyOut          : logic [DCACHE_ARRAY_PORT_NUM];

    var replArrayWE     : logic [DCACHE_ARRAY_PORT_NUM];
    var replArrayIndexIn: DCacheIndexPath [DCACHE_ARRAY_PORT_NUM];
    var replArrayDataIn : DCacheWayPath [DCACHE_ARRAY_PORT_NUM];
    var replArrayDataOut: DCacheWayPath [DCACHE_ARRAY_PORT_NUM];

    var lsuCacheReq   : logic [DCACHE_LSU_PORT_NUM];
    var lsuCacheGrt   : logic [DCACHE_LSU_PORT_NUM];
    var lsuMuxIn      : DCachePortMultiplexerIn [DCACHE_LSU_PORT_NUM];
    var lsuMuxTagOut  : DCachePortMultiplexerTagOut [DCACHE_LSU_PORT_NUM];
    var lsuMuxDataOut : DCachePortMultiplexerDataOut [DCACHE_LSU_PORT_NUM];

    var mshrCacheReq       : logic [MSHR_NUM];
    var mshrCacheGrt       : logic [MSHR_NUM];
    var mshrCacheMuxIn     : DCachePortMultiplexerIn [MSHR_NUM];
    var mshrCacheMuxTagOut : DCachePortMultiplexerTagOut [MSHR_NUM];
    var mshrCacheMuxDataOut: DCachePortMultiplexerDataOut [MSHR_NUM];

    var cacheArrayInGrant: logic [DCACHE_ARRAY_PORT_NUM];
    var cacheArrayInSel  : DCacheMuxPortIndexPath [DCACHE_ARRAY_PORT_NUM];
    var cacheArrayOutSel : DCacheArrayPortIndex [DCACHE_MUX_PORT_NUM];

    var mshrMemReq   : logic [MSHR_NUM];
    var mshrMemGrt   : logic [MSHR_NUM];
    var mshrMemMuxIn : MemoryPortMultiplexerIn [MSHR_NUM];
    var mshrMemMuxOut: MemoryPortMultiplexerOut [MSHR_NUM];
    var memInSel     : MSHR_IndexPath;

    var memAddr          : PhyAddrPath;
    var memData          : DCacheLinePath;
    var memValid         : logic;
    var memWE            : logic;
    var memReqAck        : logic;
    var memSerial        : MemAccessSerial;
    var memAccessResult  : MemAccessResult;
    var memWSerial       : MemWriteSerial;
    var memAccessResponse: MemAccessResponse;

    var initMSHR              : logic [MSHR_NUM];
    var initMSHR_Addr         : PhyAddrPath [MSHR_NUM];
    var initMSHR_ActiveListPtr: ActiveListIndexPath [MSHR_NUM];

    var mshrValid: logic [MSHR_NUM];
    var mshrAddr : PhyAddrPath [MSHR_NUM];
    var mshrPhase: MSHR_Phase [MSHR_NUM];
    var mshrData : DCacheLinePath [MSHR_NUM];

    var mshrCanBeInvalidDirect: logic [MSHR_NUM];
    var isAllocatedByStore    : logic [MSHR_NUM];
    var isUncachable          : logic [MSHR_NUM];

    var storedLineData  : VectorPath;
    var storedLineByteWE: logic<DCACHE_LINE_BYTE_NUM>;

    var lsuCacheGrtReg  : logic [DCACHE_LSU_PORT_NUM];
    var dcFlushing      : logic;
    var dcFlushReqAck   : logic;
    var dcFlushComplete : logic;
    var dcFlushReq      : logic;
    var flushComplete   : logic;
    var mshrFlushComplete: logic;

    modport DCacheController {
        clk              : input ,
        rst              : input ,
        dcFlushReq       : input ,
        flushComplete    : input ,
        mshrPhase        : input ,
        lsuCacheGrt      : input ,
        lsuCacheGrtReg   : input ,
        mshrFlushComplete: input ,
        dcFlushReqAck    : output,
        dcFlushComplete  : output,
        dcFlushing       : output,
    }

    modport DCacheArrayPortArbiter {
        lsuCacheReq      : input ,
        mshrCacheReq     : input ,
        dcFlushing       : input ,
        lsuCacheGrt      : output,
        mshrCacheGrt     : output,
        cacheArrayInSel  : output,
        cacheArrayOutSel : output,
        cacheArrayInGrant: output,
    }

    modport DCacheArrayPortMultiplexer {
        clk                        : input ,
        rst                        : input ,
        rstStart                   : input ,
        mshrCacheMuxIn             : input ,
        lsuMuxIn                   : input ,
        tagArrayDataOut            : input ,
        tagArrayValidOut           : input ,
        dataArrayDataOut           : input ,
        replArrayDataOut           : input ,
        cacheArrayInSel            : input ,
        cacheArrayOutSel           : input ,
        cacheArrayInGrant          : input ,
        dataArrayDirtyOut          : input ,
        mshrAddr                   : input ,
        mshrValid                  : input ,
        mshrPhase                  : input ,
        mshrData                   : input ,
        mshrCacheMuxTagOut         : output,
        mshrCacheMuxDataOut        : output,
        lsuMuxTagOut               : output,
        lsuMuxDataOut              : output,
        tagArrayWE                 : output,
        tagArrayWriteWay           : output,
        tagArrayIndexIn            : output,
        tagArrayDataIn             : output,
        tagArrayValidIn            : output,
        dataArrayWE                : output,
        dataArrayIndexIn           : output,
        dataArrayDataIn            : output,
        dataArrayDirtyIn           : output,
        dataArrayByteWE_In         : output,
        dataArrayWriteWay          : output,
        dataArrayReadWay           : output,
        dataArrayDoesReadEvictedWay: output,
        replArrayWE                : output,
        replArrayIndexIn           : output,
        replArrayDataIn            : output,
    }

    modport DCacheMemoryReqPortArbiter {
        mshrMemReq: input ,
        mshrMemGrt: output,
        memInSel  : output,
        memValid  : output,
    }

    modport DCacheMemoryReqPortMultiplexer {
        memReqAck    : input ,
        memSerial    : input ,
        memWSerial   : input ,
        mshrMemMuxIn : input ,
        memInSel     : input ,
        memAddr      : output,
        memData      : output,
        memWE        : output,
        mshrMemMuxOut: output,
    }

    modport DCacheMissHandler {
        clk                   : input ,
        rst                   : input ,
        initMSHR              : input ,
        initMSHR_Addr         : input ,
        initMSHR_ActiveListPtr: input ,
        mshrCacheGrt          : input ,
        mshrCacheMuxTagOut    : input ,
        mshrCacheMuxDataOut   : input ,
        mshrMemGrt            : input ,
        mshrMemMuxOut         : input ,
        memAccessResult       : input ,
        memAccessResponse     : input ,
        mshrCanBeInvalidDirect: input ,
        isAllocatedByStore    : input ,
        isUncachable          : input ,
        storedLineData        : input ,
        storedLineByteWE      : input ,
        dcFlushing            : input ,
        mshrCacheReq          : output,
        mshrCacheMuxIn        : output,
        mshrMemReq            : output,
        mshrMemMuxIn          : output,
        mshrValid             : output,
        mshrAddr              : output,
        mshrPhase             : output,
        mshrData              : output,
        mshrFlushComplete     : output,
    }

    modport DCacheArray {
        clk                        : input ,
        rst                        : input ,
        rstStart                   : input ,
        tagArrayWE                 : input ,
        tagArrayWriteWay           : input ,
        tagArrayIndexIn            : input ,
        tagArrayDataIn             : input ,
        tagArrayValidIn            : input ,
        dataArrayDataIn            : input ,
        dataArrayIndexIn           : input ,
        dataArrayDirtyIn           : input ,
        dataArrayByteWE_In         : input ,
        dataArrayWE                : input ,
        dataArrayWriteWay          : input ,
        dataArrayReadWay           : input ,
        dataArrayDoesReadEvictedWay: input ,
        replArrayWE                : input ,
        replArrayIndexIn           : input ,
        replArrayDataIn            : input ,
        tagArrayDataOut            : output,
        tagArrayValidOut           : output,
        dataArrayDataOut           : output,
        dataArrayDirtyOut          : output,
        replArrayDataOut           : output,
    }

    modport DCache {
        clk                   : input ,
        rst                   : input ,
        lsuCacheGrt           : input ,
        lsuMuxTagOut          : input ,
        lsuMuxDataOut         : input ,
        memAddr               : input ,
        memData               : input ,
        memWE                 : input ,
        memValid              : input ,
        mshrValid             : input ,
        mshrAddr              : input ,
        mshrPhase             : input ,
        dcFlushReqAck         : input ,
        dcFlushComplete       : input ,
        lsuCacheReq           : output,
        lsuMuxIn              : output,
        memReqAck             : output,
        memSerial             : output,
        memWSerial            : output,
        memAccessResponse     : output,
        initMSHR              : output,
        initMSHR_Addr         : output,
        initMSHR_ActiveListPtr: output,
        isAllocatedByStore    : output,
        isUncachable          : output,
        mshrCanBeInvalidDirect: output,
        storedLineData        : output,
        storedLineByteWE      : output,
        dcFlushReq            : output,
        flushComplete         : output,
        lsuCacheGrtReg        : output,
    }
}
