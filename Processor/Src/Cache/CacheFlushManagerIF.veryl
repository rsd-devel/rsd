//
// The interface of a cache flush management unit.
//
interface CacheFlushManagerIF {
    var clk: clock;
    var rst: logic;

    // CacheFlushManagement
    var cacheFlushReq     : logic;
    var cacheFlushComplete: logic;

    modport CacheFlushManager {
        clk               : input ,
        rst               : input ,
        cacheFlushReq     : input ,
        cacheFlushComplete: output,
    }

    modport MemoryExecutionStage {
        cacheFlushComplete: input ,
        cacheFlushReq     : output,
    }

    modport ReplayQueue {
        cacheFlushComplete: input,
    }
}
