module RetirementRMT (
    port: modport RenameLogicIF::RetirementRMT,
) {
    //
    // --- RMT for general registers
    //
    import BasicTypes::*;
    import RenameLogicTypes::*;

    var we             : logic [COMMIT_WIDTH];
    var writeLogRegNum : LRegNumPath [COMMIT_WIDTH];
    var writePhyRegNum : logic<RMT_ENTRY_BIT_SIZE> [COMMIT_WIDTH];

    var rstWriteLogRegNum: LRegNumPath [COMMIT_WIDTH];
    var rstWritePhyRegNum: logic<RMT_ENTRY_BIT_SIZE> [COMMIT_WIDTH];

    var readLogRegNum: LRegNumPath [RENAME_WIDTH];
    var readPhyRegNum: logic<RMT_ENTRY_BIT_SIZE> [RENAME_WIDTH];

    inst regRMT: DistributedMultiPortRAM #(
        ENTRY_NUM     : RMT_ENTRY_NUM      ,
        ENTRY_BIT_SIZE: RMT_ENTRY_BIT_SIZE ,
        READ_NUM      : RENAME_WIDTH       ,
        WRITE_NUM     : COMMIT_WIDTH       ,
    ) (
        clk: port.clk      ,
        we : we            ,
        wa : writeLogRegNum,
        wv : writePhyRegNum,
        ra : readLogRegNum ,
        rv : readPhyRegNum ,
    );

    always_comb {
        for i in 0..COMMIT_WIDTH {
            if !port.rst {
                // Write data
                writeLogRegNum[i] = port.retRMT_WriteReg_LogRegNum[i];
                writePhyRegNum[i] = port.retRMT_WriteReg_PhyRegNum[i].regNum;
                we[i] = port.retRMT_WriteReg[i];

                // Write to Write Bypass
                for j in 0..i {
                    if we[i] && (writeLogRegNum[i] == writeLogRegNum[j]) {
                        we[j] = FALSE;
                    }
                }
            } else {
                // Reset RMT
                writeLogRegNum[i] = rstWriteLogRegNum[i];
                writePhyRegNum[i] = rstWritePhyRegNum[i];
                if i == 0 {
                    we[i] = TRUE;
                } else {
                    we[i] = FALSE;
                }
            }
        }

        // Read data
        for i in 0..RENAME_WIDTH {
            readLogRegNum[i] = port.retRMT_ReadReg_LogRegNum[i];
            port.retRMT_ReadReg_PhyRegNum[i].regNum = readPhyRegNum[i];
            port.retRMT_ReadReg_PhyRegNum[i].isFP = port.retRMT_ReadReg_LogRegNum[i].isFP;
            // Retirement RMT is used for recovery, thus it does not require a
            // bypass logic.
        }
    }

    // - Initialization logic
    always_ff (port.clk) {
        for i in 0..COMMIT_WIDTH {
            if port.rstStart {
                rstWriteLogRegNum[i] = 0;
            } else {
                rstWriteLogRegNum[i] = rstWriteLogRegNum[i] + 1;
            }
        }
    }

    // フリーリストには0からREG_FREE_LIST_ENTRY_NUM-1が入っているので、
    // RMTの初期値はREG_FREE_LIST_ENTRY_NUM以上の値を使う
    always_comb {
        for i in 0..COMMIT_WIDTH {
            if !rstWriteLogRegNum[i].isFP {
                rstWritePhyRegNum[i] =
                    rstWriteLogRegNum[i].regNum + SCALAR_FREE_LIST_ENTRY_NUM;
            } else {
                rstWritePhyRegNum[i] =
                    rstWriteLogRegNum[i].regNum + SCALAR_FP_FREE_LIST_ENTRY_NUM;
            }
        }
    }
}
