interface ActiveListIF {
    import BasicTypes::*;
    import MicroOpTypes::*;
    import RenameLogicTypes::*;
    import SchedulerTypes::*;
    import ActiveListIndexTypes::*;
    import PipelineTypes::*;
    import LoadStoreUnitTypes::*;
    import OpFormatTypes::*;

    var clk: clock;
    var rst: logic;

    // Push 'pushedValue' on dispatch if this is true.
    var pushTail     : logic [RENAME_WIDTH];
    // This value is pushed to an active list on dispatch.
    var pushedTailData: ActiveListEntry [RENAME_WIDTH];
    // This pointer is send to an issue queue on dispatch.
    // Execution state is written to an entry corresponding to an pointer.
    var pushedTailPtr : ActiveListIndexPath [RENAME_WIDTH];

    // Pop the head entry in an active list on commitment.
    var popHeadNum: CommitLaneCountPath;
    // Pop the Tail entry in an active list on retire.
    var popTailNum: CommitLaneCountPath;

    // In RRMT recovery mode, readData become the front entries data in an active list.
    // Otherwise, readData become the tail entries data in an active list.
    var readData     : ActiveListEntry [COMMIT_WIDTH];
    // The front entries data in an active list.
    // This is used for commitment desicion.
    var headExecState: ExecutionState [COMMIT_WIDTH];
    var validEntryNum: ActiveListCountPath;

    // The count of entries from exception op to tail
    var recoveryEntryNum: ActiveListCountPath;

    // 'execState' is updated on execution.
    var intWrite    : logic [INT_ISSUE_WIDTH];
    var intWriteData: ActiveListWriteData [INT_ISSUE_WIDTH];

    var complexWrite    : logic [COMPLEX_ISSUE_WIDTH];
    var complexWriteData: ActiveListWriteData [COMPLEX_ISSUE_WIDTH];

    var memWrite    : logic [MEM_ISSUE_WIDTH];
    var memWriteData: ActiveListWriteData [MEM_ISSUE_WIDTH];

    var fpWrite     : logic [FP_ISSUE_WIDTH];
    var fpWriteData : ActiveListWriteData [FP_ISSUE_WIDTH];
    var fpFFlagsData: FFlags_Path [FP_ISSUE_WIDTH];
    var fflagsData  : FFlags_Path [COMMIT_WIDTH];

    var divWrite    : logic [MULDIV_ISSUE_WIDTH];
    var divWriteData: ActiveListWriteData [MULDIV_ISSUE_WIDTH];

    // Status of an active list.
    var allocatable: logic;

    // ActiveList/LSQ TailPtr for recovery
    var loadQueueRecoveryTailPtr : LoadQueueIndexPath;
    var storeQueueRecoveryTailPtr: StoreQueueIndexPath;

    var detectedFlushRangeTailPtr: ActiveListIndexPath;
    // Exception op's ActiveListPtr
    var exceptionOpPtr           : ActiveListIndexPath;

    // To active list
    modport ActiveList {
        clk: input,
        rst: input,
        pushTail: input,
        pushedTailData: input,
        popHeadNum: input,
        popTailNum: input,
        intWrite: input,
        intWriteData: input,
        complexWrite: input,
        complexWriteData: input,
        memWrite: input,
        memWriteData: input,
        fpWrite: input,
        fpWriteData: input,
        fpFFlagsData: input,
        divWrite: input,
        divWriteData: input,
        fflagsData: output,
        pushedTailPtr: output,
        readData: output,
        headExecState: output,
        loadQueueRecoveryTailPtr: output,
        storeQueueRecoveryTailPtr: output,
        detectedFlushRangeTailPtr: output,
        exceptionOpPtr: output,
        allocatable: output,
        validEntryNum: output,
        recoveryEntryNum: output,
    }

    // 'pushedTailPtr' is set to an entry in issue queue.
    // 'pushTail' is push request to an active list.
    // 'pushedTailData' is pushed data.
    modport RenameStage {
        allocatable: input,
        pushedTailPtr: input,
        validEntryNum: input,
        pushTail: output,
        pushedTailData: output,
    }

    modport IntegerRegisterWriteStage {
        intWrite: output,
        intWriteData: output,
    }

    modport ComplexIntegerRegisterWriteStage {
        complexWrite: output,
        complexWriteData: output,
    }

    modport MemoryRegisterWriteStage {
        memWrite: output,
        memWriteData: output,
    }

    modport FPRegisterWriteStage {
        fpWrite: output,
        fpWriteData: output,
        fpFFlagsData: output,
    }

    modport MulDivUnit {
        divWrite: output,
        divWriteData: output,
    }

    modport CommitStage {
        fflagsData: input,
        readData: input,
        headExecState: input,
        validEntryNum: input,
    }

    modport RenameLogic {
        readData: input,
        popTailNum: input,
    }

    modport RenameLogicCommitter {
        readData: input,
        recoveryEntryNum: input,
        popHeadNum: output,
        popTailNum: output,
    }

    modport RecoveryManager {
        loadQueueRecoveryTailPtr: input,
        storeQueueRecoveryTailPtr: input,
        detectedFlushRangeTailPtr: input,
        exceptionOpPtr: input,
    }
}
