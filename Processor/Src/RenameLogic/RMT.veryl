module RMT (
    port: modport RenameLogicIF::RMT,
) {
    import BasicTypes::*;
    import RenameLogicTypes::*;
    import ActiveListIndexTypes::*;
    import SchedulerTypes::*;

    var phySrcRegA    : PRegNumPath [RENAME_WIDTH];
    var phySrcRegB    : PRegNumPath [RENAME_WIDTH];
    var phySrcRegC    : PRegNumPath [RENAME_WIDTH];
    var phyPrevDstReg : PRegNumPath [RENAME_WIDTH];

    var srcIssueQueuePtrRegA: IssueQueueIndexPath [RENAME_WIDTH];
    var srcIssueQueuePtrRegB: IssueQueueIndexPath [RENAME_WIDTH];
    var srcIssueQueuePtrRegC: IssueQueueIndexPath [RENAME_WIDTH];

    struct RMT_Entry {
        phyRegNum        : logic<RMT_ENTRY_BIT_SIZE>,
        regIssueQueuePtr: IssueQueueIndexPath,
    }

    var rmtWE: logic [COMMIT_WIDTH];
    var rmtWA: LRegNumPath [COMMIT_WIDTH];
    var rmtWV: RMT_Entry [COMMIT_WIDTH];
    var rmtRA: LRegNumPath [RMT_REG_OPERAND_NUM * RENAME_WIDTH];
    var rmtRV: RMT_Entry [RMT_REG_OPERAND_NUM * RENAME_WIDTH];

    inst regRMT: DistributedMultiPortRAM #(
        ENTRY_NUM     : LREG_NUM        ,
        ENTRY_BIT_SIZE: $bits(RMT_Entry),
        READ_NUM      : RMT_REG_OPERAND_NUM * RENAME_WIDTH,
        WRITE_NUM     : COMMIT_WIDTH,
    ) (
        clk: port.clk,
        we : rmtWE,
        wa : rmtWA,
        wv : rmtWV,
        ra : rmtRA,
        rv : rmtRV,
    );

    var rstWriteLogRegNum: LRegNumPath [COMMIT_WIDTH];
    var rstWritePhyRegNum: logic<RMT_ENTRY_BIT_SIZE> [COMMIT_WIDTH];

    always_comb {
        for i in 0..COMMIT_WIDTH {
            if !port.rst {
                rmtWE[i] = port.rmtWriteReg[i];
                rmtWA[i] = port.rmtWriteReg_LogRegNum[i];
                rmtWV[i].phyRegNum = port.rmtWriteReg_PhyRegNum[i].regNum;

                for j in 0..i {
                    if rmtWE[i] && (rmtWA[i] == rmtWA[j]) {
                        rmtWE[j] = FALSE;
                    }
                }

                rmtWV[i].regIssueQueuePtr = port.watWriteIssueQueuePtr[i];
            } else {
                rmtWE[i] = i == 0;
                rmtWA[i] = rstWriteLogRegNum[i];
                rmtWV[i].phyRegNum = rstWritePhyRegNum[i];
                rmtWV[i].regIssueQueuePtr = '0;
            }
        }

        for i in 0..RENAME_WIDTH {
            rmtRA[RMT_REG_OPERAND_NUM * i] = port.logSrcRegA[i];
            rmtRA[RMT_REG_OPERAND_NUM * i + 1] = port.logSrcRegB[i];
            rmtRA[RMT_REG_OPERAND_NUM * i + 2] = port.logDstReg[i];
            rmtRA[RMT_REG_OPERAND_NUM * i + 3] = port.logSrcRegC[i];

            phySrcRegA[i].isFP = port.logSrcRegA[i].isFP;
            phySrcRegB[i].isFP = port.logSrcRegB[i].isFP;
            phySrcRegC[i].isFP = port.logSrcRegC[i].isFP;
            phyPrevDstReg[i].isFP = port.logDstReg[i].isFP;

            phySrcRegA[i].regNum =
                rmtRV[RMT_REG_OPERAND_NUM * i].phyRegNum;
            phySrcRegB[i].regNum =
                rmtRV[RMT_REG_OPERAND_NUM * i + 1].phyRegNum;
            phyPrevDstReg[i].regNum =
                rmtRV[RMT_REG_OPERAND_NUM * i + 2].phyRegNum;
            phySrcRegC[i].regNum =
                rmtRV[RMT_REG_OPERAND_NUM * i + 3].phyRegNum;

            srcIssueQueuePtrRegA[i] =
                rmtRV[RMT_REG_OPERAND_NUM * i].regIssueQueuePtr;
            srcIssueQueuePtrRegB[i] =
                rmtRV[RMT_REG_OPERAND_NUM * i + 1].regIssueQueuePtr;
            port.prevDependIssueQueuePtr[i] =
                rmtRV[RMT_REG_OPERAND_NUM * i + 2].regIssueQueuePtr;
            srcIssueQueuePtrRegC[i] =
                rmtRV[RMT_REG_OPERAND_NUM * i + 3].regIssueQueuePtr;

            for j in 0..i {
                if port.rmtWriteReg[j] {
                    if port.logSrcRegA[i] == port.logDstReg[j] {
                        phySrcRegA[i].regNum = port.rmtWriteReg_PhyRegNum[j].regNum;
                        srcIssueQueuePtrRegA[i] = port.watWriteIssueQueuePtr[j];
                    }
                    if port.logSrcRegB[i] == port.logDstReg[j] {
                        phySrcRegB[i].regNum = port.rmtWriteReg_PhyRegNum[j].regNum;
                        srcIssueQueuePtrRegB[i] = port.watWriteIssueQueuePtr[j];
                    }
                    if port.logSrcRegC[i] == port.logDstReg[j] {
                        phySrcRegC[i].regNum = port.rmtWriteReg_PhyRegNum[j].regNum;
                        srcIssueQueuePtrRegC[i] = port.watWriteIssueQueuePtr[j];
                    }
                    if port.logDstReg[i] == port.logDstReg[j] {
                        phyPrevDstReg[i].regNum = port.rmtWriteReg_PhyRegNum[j].regNum;
                        port.prevDependIssueQueuePtr[i] = port.watWriteIssueQueuePtr[j];
                    }
                }
            }
        }

        port.phySrcRegA = phySrcRegA;
        port.phySrcRegB = phySrcRegB;
        port.phySrcRegC = phySrcRegC;
        port.phyPrevDstReg = phyPrevDstReg;

        port.srcIssueQueuePtrRegA = srcIssueQueuePtrRegA;
        port.srcIssueQueuePtrRegB = srcIssueQueuePtrRegB;
        port.srcIssueQueuePtrRegC = srcIssueQueuePtrRegC;
    }

    always_ff (port.clk) {
        for i in 0..COMMIT_WIDTH {
            if port.rstStart {
                rstWriteLogRegNum[i] = 0;
            } else {
                rstWriteLogRegNum[i] = rstWriteLogRegNum[i] + 1;
            }
        }
    }

    always_comb {
        for i in 0..COMMIT_WIDTH {
            if !rstWriteLogRegNum[i].isFP {
                rstWritePhyRegNum[i] =
                    rstWriteLogRegNum[i].regNum + SCALAR_FREE_LIST_ENTRY_NUM;
            } else {
                rstWritePhyRegNum[i] =
                    rstWriteLogRegNum[i].regNum + SCALAR_FP_FREE_LIST_ENTRY_NUM;
            }
        }
    }
}
