module ActiveList (
    port    : modport ActiveListIF::ActiveList,
    recovery: modport RecoveryManagerIF::ActiveList,
    ctrl    : modport ControllerIF::ActiveList,
    debug   : modport DebugIF::ActiveList,
) {
    import BasicTypes::*;
    import MemoryMapTypes::*;
    import MicroOpTypes::*;
    import RenameLogicTypes::*;
    import SchedulerTypes::*;
    import ActiveListIndexTypes::*;
    import LoadStoreUnitTypes::*;
    import PipelineTypes::*;
    import DebugTypes::*;
    import OpFormatTypes::*;

    //
    // --- Pointers
    //
    var headPtr: ActiveListIndexPath;
    var headPtrList: ActiveListIndexPath [COMMIT_WIDTH];
    // 次に割り当てを行うエントリを指す
    var tailPtr: ActiveListIndexPath;
    var tailPtrList: ActiveListIndexPath [COMMIT_WIDTH];
    var readPtrList: ActiveListIndexPath [COMMIT_WIDTH];
    var pushedTailPtr: ActiveListIndexPath [RENAME_WIDTH];
    var count: ActiveListCountPath;
    var pushNum: RenameLaneCountPath;

    // Parameter: Size, Initial head pos., Initial tail pos., Initial count
    inst activeListPointer: BiTailMultiWidthQueuePointer #(
        SIZE            : ACTIVE_LIST_ENTRY_NUM,
        INITIAL_HEAD_PTR: 0,
        INITIAL_TAIL_PTR: 0,
        INITIAL_COUNT   : 0,
        PUSH_WIDTH      : RENAME_WIDTH,
        POP_WIDTH       : COMMIT_WIDTH,
    ) (
        clk         : port.clk,
        rst         : port.rst,
        popHead     : port.popHeadNum >: 0,
        popHeadCount: port.popHeadNum,
        pushTail    : pushNum >: 0,
        pushTailCount: pushNum,
        popTail     : port.popTailNum >: 0,
        popTailCount: port.popTailNum,
        count       : count,
        headPtr     : headPtr,
        tailPtr     : tailPtr,
    );

    always_comb {
        // In the active list, recovery and allocation can be simultaneously carried out,
        // thus allocation is decided by its current count without its phase.
        if count <= ACTIVE_LIST_ENTRY_NUM - RENAME_WIDTH {
            port.allocatable = TRUE;
        } else {
            port.allocatable = FALSE;
        }
        port.validEntryNum = count;

        pushNum = 0;
        for i in 0..RENAME_WIDTH {
            if tailPtr + pushNum >= ACTIVE_LIST_ENTRY_NUM {
                pushedTailPtr[i] = tailPtr + pushNum - ACTIVE_LIST_ENTRY_NUM;
            } else {
                pushedTailPtr[i] = tailPtr + pushNum;
            }
            pushNum = pushNum + port.pushTail[i];
        }
        for i in 0..COMMIT_WIDTH {
            if headPtr + i <: ACTIVE_LIST_ENTRY_NUM {
                headPtrList[i] = headPtr + i;
            } else {
                headPtrList[i] = headPtr + i - ACTIVE_LIST_ENTRY_NUM;
            }
        }
        for i in 0..COMMIT_WIDTH {
            //Actually limited to RENAME_WIDTH
            if tailPtr - 1 - i >= ACTIVE_LIST_ENTRY_NUM {
                tailPtrList[i] = tailPtr - 1 - i + ACTIVE_LIST_ENTRY_NUM;
            } else {
                tailPtrList[i] = tailPtr - 1 - i;
            }
        }

        if RECOVERY_FROM_ACTIVE_LIST != 0 && port.popTailNum >: 0 {
            readPtrList = tailPtrList;
        } else {
            readPtrList = headPtrList;
        }

        port.detectedFlushRangeTailPtr = tailPtr + pushNum;
        port.pushedTailPtr = pushedTailPtr;

        ctrl.activeListEmpty = count == 0;

        // Debug Register
        debug.activeListHeadPtr = headPtr;
        debug.activeListCount = count;
    }

    //
    // --- Active List
    //
    var pushTail: logic [RENAME_WIDTH];
    var pushedTailData: ActiveListEntry [RENAME_WIDTH];
    var readData: ActiveListEntry [COMMIT_WIDTH];

    inst activeList: DistributedMultiBankRAM #(
        ENTRY_NUM     : ACTIVE_LIST_ENTRY_NUM,
        ENTRY_BIT_SIZE: $bits(ActiveListEntry),
        READ_NUM      : COMMIT_WIDTH,
        WRITE_NUM     : RENAME_WIDTH,
    ) (
        clk: port.clk,
        we : pushTail,
        wa : pushedTailPtr,
        wv : pushedTailData,
        ra : readPtrList,
        rv : readData,
    );

    always_comb {
        pushTail = port.pushTail;
        pushedTailData = port.pushedTailData;
        port.readData = readData;
    }

    //
    // --- Execution result write
    //
    const EXEC_RESULT_WRITE_NUM: u32 = ISSUE_WIDTH + MULDIV_ISSUE_WIDTH;

    var we: logic [EXEC_RESULT_WRITE_NUM];
    var writeData: ActiveListWriteData [EXEC_RESULT_WRITE_NUM];

    always_comb {
        for i in 0..INT_ISSUE_WIDTH {
            we[i] = port.intWrite[i];
            writeData[i] = port.intWriteData[i];
        }
        for i in 0..COMPLEX_ISSUE_WIDTH {
            we[i + INT_ISSUE_WIDTH] = port.complexWrite[i];
            writeData[i + INT_ISSUE_WIDTH] = port.complexWriteData[i];
        }
        for i in 0..MEM_ISSUE_WIDTH {
            we[i + INT_ISSUE_WIDTH + COMPLEX_ISSUE_WIDTH] = port.memWrite[i];
            writeData[i + INT_ISSUE_WIDTH + COMPLEX_ISSUE_WIDTH] = port.memWriteData[i];
        }
        for i in 0..MULDIV_ISSUE_WIDTH {
            we[i + INT_ISSUE_WIDTH + COMPLEX_ISSUE_WIDTH + MEM_ISSUE_WIDTH] = port.divWrite[i];
            writeData[i + INT_ISSUE_WIDTH + COMPLEX_ISSUE_WIDTH + MEM_ISSUE_WIDTH] = port.divWriteData[i];
        }
        for i in 0..FP_ISSUE_WIDTH {
            we[i + INT_ISSUE_WIDTH + COMPLEX_ISSUE_WIDTH + MEM_ISSUE_WIDTH + MULDIV_ISSUE_WIDTH] = port.fpWrite[i];
            writeData[i + INT_ISSUE_WIDTH + COMPLEX_ISSUE_WIDTH + MEM_ISSUE_WIDTH + MULDIV_ISSUE_WIDTH] = port.fpWriteData[i];
        }
    }

    // Recovery register.
    // Record the oldest recovery point of an op that occurs misprediction.
    struct RecoveryRegPath {
        pc              : PC_Path,
        faultingDataAddr: AddrPath,
        ptr             : ActiveListIndexPath,
        loadQueuePtr    : LoadQueueIndexPath,
        storeQueuePtr   : StoreQueueIndexPath,
        valid           : logic,
        state           : ExecutionState,
    }

    var oldestAge: ActiveListCountPath;
    var exceptionDetected: logic;
    var refetchType: RefetchType;
    var startRecoveryAtCommit: logic;

    var recoveryReg: RecoveryRegPath;
    var nextRecoveryReg: RecoveryRegPath;
    var recoveryEntryNum: ActiveListCountPath;
    var nextRecoveryEntryNum: ActiveListCountPath;
    var flushRangeHeadPtr: ActiveListIndexPath;
    var flushRangeTailPtr: ActiveListIndexPath;

    always_ff (port.clk) {
        if port.rst || ((recovery.toRecoveryPhase && !exceptionDetected) && !startRecoveryAtCommit) {
            // Reset recoveryReg
            // But, to handle exceptions correctly, do not reset the recoveryReg in the following cases:
            //   1) another exception occurs when starting recovery
            //   2) need to start recovery at commit time
            recoveryReg = '0;
        } else {
            recoveryReg = nextRecoveryReg;
        }
    }

    // One cycle delay for RenameLogicCommitter.
    always_ff (port.clk) {
        if port.rst {
            recoveryEntryNum = '0;
        } else if recovery.toRecoveryPhase {
            recoveryEntryNum = nextRecoveryEntryNum;
        }
    }

    always_comb {
        nextRecoveryReg = recoveryReg;
        oldestAge = ActiveListPtrToAge(recoveryReg.ptr, headPtr);

        exceptionDetected = FALSE;
        refetchType = REFETCH_TYPE_THIS_PC;
        startRecoveryAtCommit = FALSE;

        for i in 0..EXEC_RESULT_WRITE_NUM {
            var writeAgeValue: ActiveListCountPath;
            writeAgeValue = ActiveListPtrToAge(writeData[i].ptr, headPtr);

            if we[i] &&
               writeData[i].state != EXEC_STATE_NOT_FINISHED &&
               writeData[i].state != EXEC_STATE_SUCCESS {
                if !nextRecoveryReg.valid || writeAgeValue <: oldestAge {
                    oldestAge = writeAgeValue;
                    nextRecoveryReg.valid = TRUE;
                    nextRecoveryReg.ptr = writeData[i].ptr;
                    nextRecoveryReg.loadQueuePtr = writeData[i].loadQueuePtr;
                    nextRecoveryReg.storeQueuePtr = writeData[i].storeQueuePtr;
                    nextRecoveryReg.pc = writeData[i].pc;
                    nextRecoveryReg.faultingDataAddr = writeData[i].dataAddr;
                    nextRecoveryReg.state = writeData[i].state;

                    // Need to update the recovery register when handling exceptions at commit time
                    if writeData[i].state == EXEC_STATE_REFETCH_NEXT ||
                       writeData[i].state == EXEC_STATE_REFETCH_THIS {
                        exceptionDetected = TRUE;
                    } else {
                        exceptionDetected = FALSE;
                    }
                    if writeData[i].state != EXEC_STATE_REFETCH_NEXT &&
                       writeData[i].state != EXEC_STATE_REFETCH_THIS {
                        startRecoveryAtCommit = TRUE;
                    }

                    // refetchTypeはflushOpのheadPtrを決めるためとrecoveredPCを確定するために使う
                    // Int命令の例外は分岐命令なので分岐ターゲットに飛ぶ
                    // Mem命令のREFETCH_NEXTは順序違反検出なので次のPCに飛ぶ
                    if writeData[i].state == EXEC_STATE_REFETCH_NEXT {
                        if writeData[i].isBranch {
                            refetchType = REFETCH_TYPE_BRANCH_TARGET;
                        } else if writeData[i].isStore {
                            refetchType = REFETCH_TYPE_STORE_NEXT_PC;
                        } else {
                            refetchType = REFETCH_TYPE_NEXT_PC;
                        }
                    } else {
                        refetchType = REFETCH_TYPE_THIS_PC;
                    }
                }
            }

            if exceptionDetected && !recovery.unableToStartRecovery {
                nextRecoveryReg.state = EXEC_STATE_SUCCESS;
            }
        }

        //PCのリカバリに用いる
        //これらのPCはRecoveryManagerのRecoveryRegisterを経由してFetchStageに送られる
        recovery.recoveredPC_FromCommitStage = ToAddrFromPC(recoveryReg.pc);
        recovery.recoveredPC_FromRwStage = ToAddrFromPC(nextRecoveryReg.pc);
        // Fault handling
        recovery.faultingDataAddr = recoveryReg.faultingDataAddr;

        //LSQのリカバリに用いる
        port.loadQueueRecoveryTailPtr = recoveryReg.loadQueuePtr;
        port.storeQueueRecoveryTailPtr = recoveryReg.storeQueuePtr;

        //リカバリをしなければならない命令はアクティブリストのtailからリカバリを起こした命令(またはその命令の後ろ)までのエントリにあたる
        flushRangeHeadPtr = recovery.flushRangeHeadPtr;
        flushRangeTailPtr = recovery.flushRangeTailPtr;

        if flushRangeHeadPtr == flushRangeTailPtr && count == ACTIVE_LIST_ENTRY_NUM {
            // Flush all insts in ActiveList
            // Because head and tail pointers match when ActiveList is full or empty,
            // flushAllInsns is needed to distinguish between them
            nextRecoveryEntryNum = ACTIVE_LIST_ENTRY_NUM;
            recovery.flushAllInsns = TRUE;
        } else {
            if flushRangeTailPtr >= flushRangeHeadPtr {
                nextRecoveryEntryNum = flushRangeTailPtr - flushRangeHeadPtr;
            } else {
                nextRecoveryEntryNum = ACTIVE_LIST_ENTRY_NUM + flushRangeTailPtr - flushRangeHeadPtr;
            }
            recovery.flushAllInsns = FALSE;
        }

        // RenameLogicCommitterにtoRecoveryPhase信号が
        // 届いた次のサイクルに信号を送る必要があるので,1サイクルの遅延を入れている
        port.recoveryEntryNum = recoveryEntryNum;
        // RecoveryManagerに例外が検出されたことを知らせる信号
        // 先行してRwステージリカバリを行っていた場合は, コミット時まで待つ
        recovery.exceptionDetectedInRwStage = exceptionDetected && !recovery.unableToStartRecovery;
        recovery.refetchTypeFromRwStage = refetchType;
        // flushRangeHeadPtrを保存するために用いる
        port.exceptionOpPtr = nextRecoveryReg.ptr;
    }

    //
    // --- ExecutionState
    //
    const EXEC_STATE_WRITE_NUM: u32 = RENAME_WIDTH + EXEC_RESULT_WRITE_NUM;

    var esWE: logic [EXEC_STATE_WRITE_NUM];
    var esWA: ActiveListIndexPath [EXEC_STATE_WRITE_NUM];
    var esRA: ActiveListIndexPath [COMMIT_WIDTH];
    var esWV: logic [EXEC_STATE_WRITE_NUM];
    var esRV: logic [COMMIT_WIDTH];
    var headExecState: ExecutionState [COMMIT_WIDTH];

    inst execState: DistributedMultiPortRAM #(
        ENTRY_NUM     : ACTIVE_LIST_ENTRY_NUM,
        ENTRY_BIT_SIZE: $bits(logic),
        READ_NUM      : COMMIT_WIDTH,
        WRITE_NUM     : EXEC_STATE_WRITE_NUM,
    ) (
        clk: port.clk,
        we : esWE,
        wa : esWA,
        wv : esWV,
        ra : esRA,
        rv : esRV,
    );

    always_comb {
        if port.rst {
            // Head entries are initialized.
            for i in 0..EXEC_STATE_WRITE_NUM {
                esWE[i] = FALSE;
                esWA[i] = i;
                esWV[i] = FALSE;
            }
        } else {
            for i in 0..RENAME_WIDTH {
                esWE[i] = port.pushTail[i];
                esWA[i] = pushedTailPtr[i];
                esWV[i] = FALSE;
            }

            for i in 0..EXEC_RESULT_WRITE_NUM {
                esWE[i + RENAME_WIDTH] = we[i];
                esWA[i + RENAME_WIDTH] = writeData[i].ptr;
                //Rwステージで検出された例外はコミットステージで再度検出されないようにExecStateをEXEC_STATE_SUCCESSにしておく必要がある
                //exceptionIndexは例外を起こした命令の場所を示す
                esWV[i + RENAME_WIDTH] = writeData[i].state != EXEC_STATE_NOT_FINISHED;
            }
        }

        esRA = headPtrList;
        for i in 0..COMMIT_WIDTH {
            if recoveryReg.valid && esRA[i] == recoveryReg.ptr {
                headExecState[i] = recoveryReg.state;
            } else {
                if esRV[i] {
                    headExecState[i] = EXEC_STATE_SUCCESS;
                } else {
                    headExecState[i] = EXEC_STATE_NOT_FINISHED;
                }
            }
        }
        port.headExecState = headExecState;
    }

    //
    // --- FFLAGS state
    //
    const FFLAGS_STATE_WRITE_NUM: u32 = RENAME_WIDTH + FP_ISSUE_WIDTH;

    var ffsWE: logic [FFLAGS_STATE_WRITE_NUM];
    var ffsWA: ActiveListIndexPath [FFLAGS_STATE_WRITE_NUM];
    var ffsRA: ActiveListIndexPath [COMMIT_WIDTH];
    var ffsWV: FFlags_Path [FFLAGS_STATE_WRITE_NUM];
    var ffsRV: FFlags_Path [COMMIT_WIDTH];

    inst fflagsState: DistributedMultiPortRAM #(
        ENTRY_NUM     : ACTIVE_LIST_ENTRY_NUM,
        ENTRY_BIT_SIZE: $bits(FFlags_Path),
        READ_NUM      : COMMIT_WIDTH,
        WRITE_NUM     : FFLAGS_STATE_WRITE_NUM,
    ) (
        clk: port.clk,
        we : ffsWE,
        wa : ffsWA,
        wv : ffsWV,
        ra : ffsRA,
        rv : ffsRV,
    );

    always_comb {
        if port.rst {
            // Head entries are initialized.
            for i in 0..FFLAGS_STATE_WRITE_NUM {
                ffsWE[i] = FALSE;
                ffsWA[i] = i;
                ffsWV[i] = '0;
            }
        } else {
            for i in 0..RENAME_WIDTH {
                ffsWE[i] = port.pushTail[i];
                ffsWA[i] = pushedTailPtr[i];
                ffsWV[i] = '0;
            }

            for i in 0..FP_ISSUE_WIDTH {
                ffsWE[i + RENAME_WIDTH] =
                    we[i + INT_ISSUE_WIDTH + COMPLEX_ISSUE_WIDTH + MEM_ISSUE_WIDTH + MULDIV_ISSUE_WIDTH];
                ffsWA[i + RENAME_WIDTH] =
                    writeData[i + INT_ISSUE_WIDTH + COMPLEX_ISSUE_WIDTH + MEM_ISSUE_WIDTH + MULDIV_ISSUE_WIDTH].ptr;
                ffsWV[i + RENAME_WIDTH] = port.fpFFlagsData[i];
            }
        }

        ffsRA = headPtrList;
        port.fflagsData = ffsRV;
    }

    // NOT_TRANSPILED_TO_VERYL
    // The non-synthesis reference ExecState RAM and its RSD_ASSERT_CLK block are omitted because
    // the macro assertion and break-based reference scan are not transpilable to Veryl.
}
