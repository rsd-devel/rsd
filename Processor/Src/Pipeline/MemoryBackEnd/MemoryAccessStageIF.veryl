interface MemoryAccessStageIF {
    import BasicTypes::*;
    import PipelineTypes::*;

    var clk      : clock;
    var rst      : logic;
    // Pipeline register
    var nextStage: MemoryRegisterWriteStageRegPath [MEM_ISSUE_WIDTH];

    modport ThisStage {
        clk      : input ,
        rst      : input ,
        nextStage: output,
    }

    modport NextStage {
        nextStage: input,
    }
}
