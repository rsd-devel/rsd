module MemoryTagAccessStage (
    port         : modport MemoryTagAccessStageIF::ThisStage       ,
    prev         : modport MemoryExecutionStageIF::NextStage        ,
    scheduler    : modport SchedulerIF::MemoryTagAccessStage       ,
    loadStoreUnit: modport LoadStoreUnitIF::MemoryTagAccessStage   ,
    recovery     : modport RecoveryManagerIF::MemoryTagAccessStage ,
    ctrl         : modport ControllerIF::MemoryTagAccessStage      ,
    amoCache     : modport AMOCacheIF::MemoryTagAccessStage        ,
    debug        : modport DebugIF::MemoryTagAccessStage           ,
    perfCounter  : modport PerformanceCounterIF::MemoryTagAccessStage,
) {
    import BasicTypes::*;
    import OpFormatTypes::*;
    import RenameLogicTypes::*;
    import SchedulerTypes::*;
    import ActiveListIndexTypes::*;
    import PipelineTypes::*;
    import DebugTypes::*;
    import MicroOpTypes::*;
    import CacheSystemTypes::*;
    import MemoryMapTypes::*;
    import LoadStoreUnitTypes::*;

    var pipeReg  : MemoryTagAccessStageRegPath [MEM_ISSUE_WIDTH];
    var ldPipeReg: MemoryTagAccessStageRegPath [LOAD_ISSUE_WIDTH];
    var stPipeReg: MemoryTagAccessStageRegPath [STORE_ISSUE_WIDTH];

    // NOT_TRANSPILED_TO_VERYL
    // Non-synthesis initial debug initialization was not transpilable to native Veryl initial syntax.

    // --- Pipeline registers
    always_ff (port.clk) {
        if port.rst {
            for i in 0..MEM_ISSUE_WIDTH {
                pipeReg[i].valid = '0;
            }
        } else if !ctrl.backEnd.stall {
            pipeReg = prev.nextStage;
        }
    }

    var stall: logic;
    var clear: logic;

    var ldIqData: MemIssueQueueEntry [LOAD_ISSUE_WIDTH];
    var stIqData: MemIssueQueueEntry [STORE_ISSUE_WIDTH];

    always_comb {
        // Pipeline control
        stall = ctrl.backEnd.stall;
        clear = ctrl.backEnd.clear;

        for i in 0..LOAD_ISSUE_WIDTH {
            ldPipeReg[i] = pipeReg[i];
            ldIqData[i] = pipeReg[i].memQueueData;
        }
        for i in 0..STORE_ISSUE_WIDTH {
            stPipeReg[i] = pipeReg[i + STORE_ISSUE_LANE_BEGIN];
            stIqData[i] = pipeReg[i + STORE_ISSUE_LANE_BEGIN].memQueueData;
        }
    }

    var update_is_reserved_byLR: logic;
    var update_is_reserved_bySC: logic;
    var last_is_reserved: logic;
    var prev_is_reserved: logic;
    var last_reserved_addr: PhyAddrPath;
    var prev_reserved_addr: PhyAddrPath;

    // LR SC
    always_ff (port.clk) {
        if port.rst {
            prev_is_reserved = FALSE;
            prev_reserved_addr = '0;
        } else {
            if update_is_reserved_byLR {
                prev_is_reserved = last_is_reserved;
                prev_reserved_addr = last_reserved_addr;
            }
            if update_is_reserved_bySC {
                prev_is_reserved = FALSE;
            }
        }
    }

    var replaceStoreByLoad: logic;
    var executeStore: logic [STORE_ISSUE_WIDTH + 1];
    var executedStoreData: DataPath [STORE_ISSUE_WIDTH + 1];
    var executedStoreVectorData: VectorPath [STORE_ISSUE_WIDTH + 1];
    var executedStoreAddr: PhyAddrPath [STORE_ISSUE_WIDTH + 1];
    var executedStoreCondEnabled: logic [STORE_ISSUE_WIDTH + 1];
    var executedStoreRegValid: logic [STORE_ISSUE_WIDTH + 1];
    var executedStoreMemAccessMode: MemAccessMode [STORE_ISSUE_WIDTH + 1];
    var executedLoadQueuePtrByStore: LoadQueueIndexPath [STORE_ISSUE_WIDTH + 1];
    var executedStoreQueuePtrByStore: StoreQueueIndexPath [STORE_ISSUE_WIDTH + 1];

    // load store unit
    always_comb {
        for i in 0..STORE_ISSUE_WIDTH {
            if i == 0 && replaceStoreByLoad {
                loadStoreUnit.executeStore[i] = executeStore[STORE_ISSUE_WIDTH];
                loadStoreUnit.executedStoreData[i] = executedStoreData[STORE_ISSUE_WIDTH];
                loadStoreUnit.executedStoreVectorData[i] = executedStoreVectorData[STORE_ISSUE_WIDTH];
                loadStoreUnit.executedStoreAddr[i] = executedStoreAddr[STORE_ISSUE_WIDTH];
                loadStoreUnit.executedStoreCondEnabled[i] = executedStoreCondEnabled[STORE_ISSUE_WIDTH];
                loadStoreUnit.executedStoreRegValid[i] = executedStoreRegValid[STORE_ISSUE_WIDTH];
                loadStoreUnit.executedStoreMemAccessMode[i] = executedStoreMemAccessMode[STORE_ISSUE_WIDTH];
                loadStoreUnit.executedLoadQueuePtrByStore[i] = executedLoadQueuePtrByStore[STORE_ISSUE_WIDTH];
                loadStoreUnit.executedStoreQueuePtrByStore[i] = executedStoreQueuePtrByStore[STORE_ISSUE_WIDTH];
            } else {
                loadStoreUnit.executeStore[i] = executeStore[i];
                loadStoreUnit.executedStoreData[i] = executedStoreData[i];
                loadStoreUnit.executedStoreVectorData[i] = executedStoreVectorData[i];
                loadStoreUnit.executedStoreAddr[i] = executedStoreAddr[i];
                loadStoreUnit.executedStoreCondEnabled[i] = executedStoreCondEnabled[i];
                loadStoreUnit.executedStoreRegValid[i] = executedStoreRegValid[i];
                loadStoreUnit.executedStoreMemAccessMode[i] = executedStoreMemAccessMode[i];
                loadStoreUnit.executedLoadQueuePtrByStore[i] = executedLoadQueuePtrByStore[i];
                loadStoreUnit.executedStoreQueuePtrByStore[i] = executedStoreQueuePtrByStore[i];
            }
        }
    }

    var isLoad: logic [LOAD_ISSUE_WIDTH];
    var isCSR: logic [LOAD_ISSUE_WIDTH];
    var isENV: logic [LOAD_ISSUE_WIDTH];
    var ldUpdate: logic [LOAD_ISSUE_WIDTH];
    var ldRegValid: logic [LOAD_ISSUE_WIDTH];
    var ldFlush: logic [LOAD_ISSUE_WIDTH];
    var isDiv: logic [LOAD_ISSUE_WIDTH];
    var isMul: logic [LOAD_ISSUE_WIDTH];
    var isFenceI: logic [LOAD_ISSUE_WIDTH];
    var isZaamo: logic [LOAD_ISSUE_WIDTH];
    var amoCacheHit: logic [LOAD_ISSUE_WIDTH];
    var storeForwardMiss: logic [LOAD_ISSUE_WIDTH];
    var ldNextStage: MemoryAccessStageRegPath [LOAD_ISSUE_WIDTH];
    // for ReplayQueue
    var ldRecordData: MemIssueQueueEntry [LOAD_ISSUE_WIDTH];

    var ldMSHR_Allocated: logic [LOAD_ISSUE_WIDTH];
    var ldMSHR_Hit: logic [LOAD_ISSUE_WIDTH];
    var ldMSHR_EntryID: DataPath [LOAD_ISSUE_WIDTH];

    always_comb {
        update_is_reserved_byLR = FALSE;
        last_is_reserved = FALSE;
        last_reserved_addr = '0;

        for i in 0..LOAD_ISSUE_WIDTH {
            ldFlush[i] = SelectiveFlushDetector(
                recovery.toRecoveryPhase,
                recovery.flushRangeHeadPtr,
                recovery.flushRangeTailPtr,
                recovery.flushAllInsns,
                ldIqData[i].activeListPtr
            );
            ldUpdate[i] = ldPipeReg[i].valid && !stall && !clear && !ldFlush[i];
            isLoad[i] = ldIqData[i].memOpInfo.opType == MEM_MOP_TYPE_LOAD;
            isCSR[i] = ldIqData[i].memOpInfo.opType == MEM_MOP_TYPE_CSR;
            isENV[i] = ldIqData[i].memOpInfo.opType == MEM_MOP_TYPE_ENV;
            isDiv[i] = ldIqData[i].memOpInfo.opType == MEM_MOP_TYPE_DIV;
            isMul[i] = ldIqData[i].memOpInfo.opType == MEM_MOP_TYPE_MUL;
            isFenceI[i] = ldIqData[i].memOpInfo.opType == MEM_MOP_TYPE_FENCE && ldIqData[i].memOpInfo.isFenceI;
            isZaamo[i] = ldIqData[i].memOpInfo.opType == MEM_MOP_TYPE_ZAAMO;
            amoCacheHit[i] = amoCache.cached && amoCache.readAddr == ldPipeReg[i].phyAddrOut;

            // Load store unit
            loadStoreUnit.executeLoad[i] = ldUpdate[i] && (isLoad[i] || (isZaamo[i] && !amoCacheHit[i]));
            loadStoreUnit.executedLoadAddr[i] = ldPipeReg[i].phyAddrOut;
            loadStoreUnit.executedLoadMemMapType[i] = ldPipeReg[i].memMapType;
            loadStoreUnit.executedLoadPC[i] = ldIqData[i].pc;
            loadStoreUnit.executedLoadMemAccessMode[i] = ldIqData[i].memOpInfo.memAccessMode;
            loadStoreUnit.executedStoreQueuePtrByLoad[i] = ldIqData[i].storeQueuePtr;
            loadStoreUnit.executedLoadQueuePtrByLoad[i] = ldIqData[i].loadQueuePtr;

            // Set hasAllocatedMSHR and mshrID info to notice ReplayQueue
            // whether missed loads have allocated MSHRs or not.
            ldRecordData[i].opId = ldIqData[i].opId;
            ldRecordData[i].activeListPtr = ldIqData[i].activeListPtr;
            ldRecordData[i].opSrc = ldIqData[i].opSrc;
            ldRecordData[i].opDst = ldIqData[i].opDst;
            ldRecordData[i].pc = ldIqData[i].pc;
            ldRecordData[i].memOpInfo = ldIqData[i].memOpInfo;
            ldRecordData[i].storeQueueRecoveryPtr = ldIqData[i].storeQueueRecoveryPtr;
            ldRecordData[i].loadQueueRecoveryPtr = ldIqData[i].loadQueueRecoveryPtr;
            ldRecordData[i].loadQueuePtr = ldIqData[i].loadQueuePtr;
            ldRecordData[i].storeQueuePtr = ldIqData[i].storeQueuePtr;
            ldRecordData[i].hasLoadedAMOCache = FALSE;

            ldMSHR_Allocated[i] = FALSE;
            ldMSHR_Hit[i] = FALSE;
            ldMSHR_EntryID[i] = 0;
            storeForwardMiss[i] = FALSE;

            // Set MSHR id if the load instruction allocated a MSHR entry.
            if ldIqData[i].hasAllocatedMSHR {
                ldRecordData[i].hasAllocatedMSHR = ldIqData[i].hasAllocatedMSHR;
                ldRecordData[i].mshrID = ldIqData[i].mshrID;

                // 前回実行時に MSHR を確保したがリプレイ時に SQ からのフォワードミスが発生した場合
                // MSHR を手放さないと先行するストアがコミットできずデッドロックする
                // storeForwardMiss を後段に伝えて RW ステージで MSHR を解放し，MSHR を確保したフラグをここで落とす
                if loadStoreUnit.storeLoadForwarded[i] && loadStoreUnit.forwardMiss[i] {
                    storeForwardMiss[i] = TRUE;
                    ldRecordData[i].hasAllocatedMSHR = FALSE;
                }
            } else {
                ldRecordData[i].hasAllocatedMSHR = loadStoreUnit.loadHasAllocatedMSHR[i];
                if loadStoreUnit.loadHasAllocatedMSHR[i] {
                    ldRecordData[i].mshrID = loadStoreUnit.loadMSHRID[i];
                    // MSHR allocation is performed
                    ldMSHR_Allocated[i] = TRUE;
                    ldMSHR_EntryID[i] = loadStoreUnit.loadMSHRID[i];
                } else if loadStoreUnit.mshrAddrHit[i] {
                    ldRecordData[i].mshrID = loadStoreUnit.mshrAddrHitMSHRID[i];
                    // MSHR Hit?
                    ldMSHR_Hit[i] = loadStoreUnit.mshrReadHit[i];
                    ldMSHR_EntryID[i] = loadStoreUnit.mshrAddrHitMSHRID[i];
                } else {
                    ldRecordData[i].mshrID = ldIqData[i].mshrID;
                }
            }

            if isLoad[i] || isZaamo[i] {
                if isZaamo[i] && amoCacheHit[i] {
                    // When AMO cache hit, the data comes from AMO cache.
                    ldRegValid[i] = ldPipeReg[i].regValid;
                } else if loadStoreUnit.storeLoadForwarded[i] {
                    ldRegValid[i] = ldPipeReg[i].regValid;
                } else if ldRecordData[i].hasAllocatedMSHR {
                    // When the load has allocated an MSHR entry,
                    // The data will come from MSHR.
                    if loadStoreUnit.mshrReadHit[i] {
                        ldRegValid[i] = ldPipeReg[i].regValid;
                    } else {
                        ldRegValid[i] = FALSE;
                    }
                } else if loadStoreUnit.mshrReadHit[i] {
                    ldRegValid[i] = ldPipeReg[i].regValid;
                } else {
                    // The consumers of a missed load is invalidate.
                    if loadStoreUnit.dcReadHit[i] {
                        ldRegValid[i] = ldPipeReg[i].regValid;
                    } else {
                        ldRegValid[i] = FALSE;
                    }
                }
            } else if ldRecordData[i].hasAllocatedMSHR {
                // When the prefetch load has allocated an MSHR entry,
                // The data will come from MSHR.
                if loadStoreUnit.mshrReadHit[i] {
                    ldRegValid[i] = ldPipeReg[i].regValid;
                } else {
                    ldRegValid[i] = FALSE;
                }
            } else {
                ldRegValid[i] = ldPipeReg[i].regValid;
            }

            // Sends to the load queue whether the load executed in this cycle is valid.
            loadStoreUnit.executedLoadRegValid[i] = ldRegValid[i];

            // Pipeline レジスタ書き込み
            ldNextStage[i].regValid = ldRegValid[i];
            ldNextStage[i].addrOut = ldPipeReg[i].addrOut;
            ldNextStage[i].memMapType = ldPipeReg[i].memMapType;
            ldNextStage[i].phyAddrOut = ldPipeReg[i].phyAddrOut;
            ldNextStage[i].csrDataOut = ldPipeReg[i].dataIn;

            ldNextStage[i].isLoad = isLoad[i];
            ldNextStage[i].isStore = FALSE;
            ldNextStage[i].isZalrsc = ldIqData[i].memOpInfo.isZalrsc;
            ldNextStage[i].isZaamo = isZaamo[i];
            ldNextStage[i].isCSR = isCSR[i];
            ldNextStage[i].isDiv = isDiv[i];
            ldNextStage[i].isMul = isMul[i];

            ldNextStage[i].opDst = ldIqData[i].opDst;
            ldNextStage[i].activeListPtr = ldIqData[i].activeListPtr;
            ldNextStage[i].loadQueueRecoveryPtr = ldIqData[i].loadQueueRecoveryPtr;
            ldNextStage[i].storeQueueRecoveryPtr = ldIqData[i].storeQueueRecoveryPtr;
            ldNextStage[i].pc = ldIqData[i].pc;

            ldNextStage[i].hasAllocatedMSHR = ldRecordData[i].hasAllocatedMSHR;
            ldNextStage[i].mshrID = ldRecordData[i].mshrID;
            ldNextStage[i].storeForwardMiss = storeForwardMiss[i];

            ldNextStage[i].isScFail = FALSE;
            ldNextStage[i].amoCacheHit = amoCacheHit[i];
            ldNextStage[i].writeAMOCache = FALSE;

            // ExecState
            // 命令の実行結果によって、再フェッチが必要かどうかなどを判定する
            if !ldUpdate[i] || (ldUpdate[i] && !ldRegValid[i]) {
                ldNextStage[i].execState = EXEC_STATE_NOT_FINISHED;
            } else if isLoad[i] || (isZaamo[i] && !amoCacheHit[i]) {
                if loadStoreUnit.storeLoadForwarded[i] {
                    // フォワードされた場合
                    // A load instruction that caused a store-load forwarding miss is not replayed but flushed to prevent a deadlock due to replay.
                    // To wait for the commit of the dependent store instruction, The flush is performed in commit stage.
                    if loadStoreUnit.forwardMiss[i] {
                        ldNextStage[i].execState = EXEC_STATE_STORE_LOAD_FORWARDING_MISS;
                    } else {
                        ldNextStage[i].execState = EXEC_STATE_SUCCESS;
                    }
                } else if ldRecordData[i].hasAllocatedMSHR {
                    if loadStoreUnit.mshrReadHit[i] {
                        ldNextStage[i].execState = EXEC_STATE_SUCCESS;
                    } else {
                        ldNextStage[i].execState = EXEC_STATE_REFETCH_THIS;
                    }
                } else if loadStoreUnit.mshrReadHit[i] {
                    ldNextStage[i].execState = EXEC_STATE_SUCCESS;
                } else {
                    // DCache
                    if loadStoreUnit.dcReadHit[i] {
                        ldNextStage[i].execState = EXEC_STATE_SUCCESS;
                    } else {
                        ldNextStage[i].execState = EXEC_STATE_REFETCH_THIS;
                    }
                }
            } else if isZaamo[i] && amoCacheHit[i] {
                ldNextStage[i].execState = EXEC_STATE_SUCCESS;
            } else if ldRecordData[i].hasAllocatedMSHR {
                if loadStoreUnit.mshrReadHit[i] {
                    ldNextStage[i].execState = EXEC_STATE_SUCCESS;
                } else {
                    ldNextStage[i].execState = EXEC_STATE_REFETCH_THIS;
                }
            } else if isENV[i] {
                // EBREAK/ECALL/MRET/SRET はトラップ扱い
                case ldIqData[i].memOpInfo.envCode {
                    ENV_BREAK: {
                        ldNextStage[i].execState = EXEC_STATE_TRAP_EBREAK;
                    }
                    ENV_CALL: {
                        ldNextStage[i].execState = EXEC_STATE_TRAP_ECALL;
                    }
                    ENV_SRET: {
                        ldNextStage[i].execState = EXEC_STATE_TRAP_SRET;
                    }
                    ENV_MRET: {
                        ldNextStage[i].execState = EXEC_STATE_TRAP_MRET;
                    }
                    ENV_INSN_ILLEGAL: {
                        ldNextStage[i].execState = EXEC_STATE_FAULT_INSN_ILLEGAL;
                    }
                    ENV_INSN_VIOLATION: {
                        ldNextStage[i].execState = EXEC_STATE_FAULT_INSN_VIOLATION;
                    }
                    default: {
                        ldNextStage[i].execState = EXEC_STATE_TRAP_EBREAK;
                    }
                }
            } else if isFenceI[i] {
                // FENCE.I flush all following ops when it is committed
                // not to use the expired data from ICache.
                ldNextStage[i].execState = EXEC_STATE_REFETCH_NEXT;
            } else {
                ldNextStage[i].execState = EXEC_STATE_SUCCESS;
            }

            // 実行が正しく終了してる場合，フォールト判定を行う
            // ストアの依存予測ではこちらの方が優先される
            if ldNextStage[i].execState == EXEC_STATE_SUCCESS || ldNextStage[i].execState == EXEC_STATE_REFETCH_NEXT {
                if isLoad[i] {
                    if ldPipeReg[i].memMapType == MMT_ILLEGAL {
                        if ldIqData[i].memOpInfo.isZalrsc || isZaamo[i] {
                            ldNextStage[i].execState = EXEC_STATE_FAULT_STORE_VIOLATION;
                        } else {
                            ldNextStage[i].execState = EXEC_STATE_FAULT_LOAD_VIOLATION;
                        }
                    } else if IsMisalignedAddress(ldPipeReg[i].addrOut, ldIqData[i].memOpInfo.memAccessMode.size) {
                        if ldIqData[i].memOpInfo.isZalrsc || isZaamo[i] {
                            ldNextStage[i].execState = EXEC_STATE_FAULT_STORE_MISALIGNED;
                        } else {
                            ldNextStage[i].execState = EXEC_STATE_FAULT_LOAD_MISALIGNED;
                        }
                    }
                }
            }

            // RVA LR
            if ldNextStage[i].execState == EXEC_STATE_SUCCESS {
                // LR
                if i == 0 && isLoad[i] && ldIqData[i].memOpInfo.isZalrsc {
                    update_is_reserved_byLR = TRUE;
                    last_is_reserved = TRUE;
                    last_reserved_addr = ldPipeReg[i].phyAddrOut;
                }
            }

            // Zaamoのとき、AmoCacheにロードできるか確認する
            if isZaamo[i] && !amoCacheHit[i] {
                if ldNextStage[i].execState == EXEC_STATE_SUCCESS {
                    // AMOCacheにロードして、ストアをやり直す
                    ldRegValid[i] = FALSE;
                    ldRecordData[i].hasLoadedAMOCache = TRUE;
                    ldNextStage[i].execState = EXEC_STATE_NOT_FINISHED;
                    ldNextStage[i].writeAMOCache = TRUE;
                }
            }

            // Zaamoのストア
            if i == 0 {
                replaceStoreByLoad = ldUpdate[i] && ldRegValid[i] && isZaamo[i] && amoCacheHit[i];
                executeStore[STORE_ISSUE_WIDTH] = TRUE;
                executedStoreData[STORE_ISSUE_WIDTH] = ldPipeReg[i].dataIn;
                executedStoreVectorData[STORE_ISSUE_WIDTH] = '0;
                executedStoreAddr[STORE_ISSUE_WIDTH] = ldPipeReg[i].phyAddrOut;
                executedStoreCondEnabled[STORE_ISSUE_WIDTH] = TRUE;
                executedStoreRegValid[STORE_ISSUE_WIDTH] = ldRegValid[i];
                executedStoreMemAccessMode[STORE_ISSUE_WIDTH] = ldIqData[i].memOpInfo.memAccessMode;
                executedLoadQueuePtrByStore[STORE_ISSUE_WIDTH] = ldIqData[i].loadQueuePtr;
                executedStoreQueuePtrByStore[STORE_ISSUE_WIDTH] = ldIqData[i].storeQueuePtr;
            }

            // リセットorフラッシュ時はNOP
            if stall || clear || port.rst || ldFlush[i] {
                ldNextStage[i].valid = FALSE;
            } else {
                ldNextStage[i].valid = ldPipeReg[i].valid;
            }

            ldNextStage[i].opId = ldPipeReg[i].opId;
        }
    }

    var isStore: logic [STORE_ISSUE_WIDTH];
    var stUpdate: logic [STORE_ISSUE_WIDTH];
    var stRegValid: logic [STORE_ISSUE_WIDTH];
    var stFlush: logic [STORE_ISSUE_WIDTH];
    var stNextStage: MemoryAccessStageRegPath [STORE_ISSUE_WIDTH];
    // for ReplayQueue
    var stRecordData: MemIssueQueueEntry [STORE_ISSUE_WIDTH];
    var isScFail: logic [STORE_ISSUE_WIDTH];
    // For memory dependency prediction (only for STORE)
    var memAccessOrderViolation: logic [STORE_ISSUE_WIDTH];

    always_comb {
        update_is_reserved_bySC = FALSE;

        for i in 0..STORE_ISSUE_WIDTH {
            memAccessOrderViolation[i] = FALSE;
            stFlush[i] = SelectiveFlushDetector(
                recovery.toRecoveryPhase,
                recovery.flushRangeHeadPtr,
                recovery.flushRangeTailPtr,
                recovery.flushAllInsns,
                stIqData[i].activeListPtr
            );
            stUpdate[i] = stPipeReg[i].valid && !stall && !clear && !stFlush[i];
            isStore[i] = stIqData[i].memOpInfo.opType == MEM_MOP_TYPE_STORE;
            isScFail[i] = isStore[i] && stIqData[i].memOpInfo.isZalrsc && (!prev_is_reserved || stPipeReg[i].phyAddrOut != prev_reserved_addr);

            // Load store unit
            executeStore[i] = stUpdate[i] && isStore[i];
            executedStoreData[i] = stPipeReg[i].dataIn;
            executedStoreVectorData[i] = '0;
            executedStoreAddr[i] = stPipeReg[i].phyAddrOut;
            executedStoreCondEnabled[i] = stPipeReg[i].condEnabled && !isScFail[i];
            executedStoreRegValid[i] = stPipeReg[i].regValid;
            executedStoreMemAccessMode[i] = stIqData[i].memOpInfo.memAccessMode;
            executedLoadQueuePtrByStore[i] = stIqData[i].loadQueuePtr;
            executedStoreQueuePtrByStore[i] = stIqData[i].storeQueuePtr;

            // Set hasAllocatedMSHR and mshrID info to notice ReplayQueue
            // whether missed loads have allocated MSHRs or not.
            stRecordData[i].opId = stIqData[i].opId;
            stRecordData[i].activeListPtr = stIqData[i].activeListPtr;
            stRecordData[i].opSrc = stIqData[i].opSrc;
            stRecordData[i].opDst = stIqData[i].opDst;
            stRecordData[i].pc = stIqData[i].pc;
            stRecordData[i].storeQueueRecoveryPtr = stIqData[i].storeQueueRecoveryPtr;
            stRecordData[i].loadQueueRecoveryPtr = stIqData[i].loadQueueRecoveryPtr;
            stRecordData[i].memOpInfo = stIqData[i].memOpInfo;
            stRecordData[i].loadQueuePtr = stIqData[i].loadQueuePtr;
            stRecordData[i].storeQueuePtr = stIqData[i].storeQueuePtr;
            stRecordData[i].hasAllocatedMSHR = FALSE;
            stRecordData[i].mshrID = '0;
            stRecordData[i].hasLoadedAMOCache = FALSE;

            stRegValid[i] = stPipeReg[i].regValid;

            // Pipeline レジスタ書き込み
            stNextStage[i].regValid = stRegValid[i];
            stNextStage[i].addrOut = stPipeReg[i].addrOut;
            stNextStage[i].memMapType = stPipeReg[i].memMapType;
            stNextStage[i].phyAddrOut = stPipeReg[i].phyAddrOut;
            stNextStage[i].csrDataOut = stPipeReg[i].dataIn;

            stNextStage[i].isLoad = FALSE;
            stNextStage[i].isStore = isStore[i];
            stNextStage[i].isZalrsc = stIqData[i].memOpInfo.isZalrsc;
            stNextStage[i].isZaamo = FALSE;
            stNextStage[i].isCSR = FALSE;
            stNextStage[i].isDiv = FALSE;
            stNextStage[i].isMul = FALSE;

            stNextStage[i].opDst = stIqData[i].opDst;
            stNextStage[i].activeListPtr = stIqData[i].activeListPtr;
            stNextStage[i].loadQueueRecoveryPtr = stIqData[i].loadQueueRecoveryPtr;
            stNextStage[i].storeQueueRecoveryPtr = stIqData[i].storeQueueRecoveryPtr;
            stNextStage[i].pc = stIqData[i].pc;

            stNextStage[i].hasAllocatedMSHR = FALSE;
            stNextStage[i].mshrID = 0;
            stNextStage[i].storeForwardMiss = storeForwardMiss[i];

            stNextStage[i].isScFail = isScFail[i];
            stNextStage[i].amoCacheHit = FALSE;
            stNextStage[i].writeAMOCache = FALSE;

            // ExecState
            // 命令の実行結果によって、再フェッチが必要かどうかなどを判定する
            if !stUpdate[i] || (stUpdate[i] && !stRegValid[i]) {
                stNextStage[i].execState = EXEC_STATE_NOT_FINISHED;
            } else if isStore[i] && loadStoreUnit.conflict[i] {
                // memAccessOrderViolation
                // ストア命令自身は正しく実行できているため、
                // 次の命令からやり直す
                stNextStage[i].execState = EXEC_STATE_REFETCH_NEXT;
                // Make request for studying violation instruction to Memory dependent predictor.
                memAccessOrderViolation[i] = TRUE;
            } else {
                stNextStage[i].execState = EXEC_STATE_SUCCESS;
            }

            // 実行が正しく終了してる場合，フォールト判定を行う
            // ストアの依存予測ではこちらの方が優先される
            if stNextStage[i].execState == EXEC_STATE_SUCCESS || stNextStage[i].execState == EXEC_STATE_REFETCH_NEXT {
                if isStore[i] {
                    if stPipeReg[i].memMapType == MMT_ILLEGAL {
                        stNextStage[i].execState = EXEC_STATE_FAULT_STORE_VIOLATION;
                    } else if IsMisalignedAddress(stPipeReg[i].addrOut, stIqData[i].memOpInfo.memAccessMode.size) {
                        stNextStage[i].execState = EXEC_STATE_FAULT_STORE_MISALIGNED;
                    }
                }
            }

            // RVA SC
            if i == 0 && isStore[i] && stIqData[i].memOpInfo.isZalrsc {
                update_is_reserved_bySC = stUpdate[i] && stRegValid[i];
            }

            // リセットorフラッシュ時はNOP
            if stall || clear || port.rst || stFlush[i] {
                stNextStage[i].valid = FALSE;
            } else {
                stNextStage[i].valid = stPipeReg[i].valid;
            }

            stNextStage[i].opId = stPipeReg[i].opId;
        }
    }

    var flush: logic [MEM_ISSUE_WIDTH];
    var nextStage: MemoryAccessStageRegPath [MEM_ISSUE_WIDTH];

    always_comb {
        loadStoreUnit.memAccessOrderViolation = memAccessOrderViolation;

        for i in 0..LOAD_ISSUE_WIDTH {
            // Record instructions to the replay queue.
            scheduler.memRecordEntry[i] = ldUpdate[i] && !ldRegValid[i];
            scheduler.memRecordData[i] = ldRecordData[i];
            nextStage[i] = ldNextStage[i];
            flush[i] = ldFlush[i];
        }
        for i in 0..STORE_ISSUE_WIDTH {
            // Record instructions to the replay queue.
            scheduler.memRecordEntry[i + STORE_ISSUE_LANE_BEGIN] = stUpdate[i] && !stRegValid[i];
            scheduler.memRecordData[i + STORE_ISSUE_LANE_BEGIN] = stRecordData[i];
            nextStage[i + STORE_ISSUE_LANE_BEGIN] = stNextStage[i];
            flush[i + STORE_ISSUE_LANE_BEGIN] = stFlush[i];
        }

        port.nextStage = nextStage;
    }

    always_comb {
        for i in 0..LOAD_ISSUE_WIDTH {
            // Record misses only when a MSHR entry is allocated.
            perfCounter.loadMiss[i] = ldUpdate[i] && isLoad[i] && ldMSHR_Allocated[i];
        }

        for i in 0..MEM_ISSUE_WIDTH {
            debug.mtReg[i].valid = pipeReg[i].valid;
            debug.mtReg[i].flush = flush[i];
            debug.mtReg[i].opId = pipeReg[i].opId;
        }
    }
}
