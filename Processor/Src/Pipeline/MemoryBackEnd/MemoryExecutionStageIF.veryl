interface MemoryExecutionStageIF {
    import BasicTypes::*;
    import BypassTypes::*;
    import OpFormatTypes::*;
    import PipelineTypes::*;

    var clk      : clock;
    var rst      : logic;
    var nextStage: MemoryTagAccessStageRegPath [MEM_ISSUE_WIDTH];

    modport ThisStage {
        clk      : input ,
        rst      : input ,
        nextStage: output,
    }

    modport NextStage {
        nextStage: input,
    }
}
