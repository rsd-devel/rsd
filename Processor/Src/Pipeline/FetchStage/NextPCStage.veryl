package NextPCStageFunctions {
    import MemoryMapTypes::*;
    import CacheSystemTypes::*;

    // Detect the cache line boundary in sequential access
    function StepOverCacheLine (
        pc1: input PC_Path,
        pc2: input PC_Path,
    ) -> logic {
        return pc1[ICACHE_LINE_BYTE_NUM_BIT_WIDTH] != pc2[ICACHE_LINE_BYTE_NUM_BIT_WIDTH];
    }
}

// A pipeline stage for updating PC
module NextPCStage (
    port    : modport NextPCStageIF::ThisStage,
    next    : modport FetchStageIF::NextPCStage,
    recovery: modport RecoveryManagerIF::NextPCStage,
    ctrl    : modport ControllerIF::NextPCStage,
    debug   : modport DebugIF::NextPCStage,
) {
    import BasicTypes::*;
    import PipelineTypes::*;
    import MemoryMapTypes::*;
    import CacheSystemTypes::*;
    import FetchUnitTypes::*;
    import NextPCStageFunctions::*;

    // デバッグ用SID
    // 内部事情により，1 からはじめる
    var curSID: OpSerial;
    var nextSID: OpSerial;

    inst sidFF: FlipFlop #(
        FF_WIDTH   : OP_SERIAL_WIDTH,
        RESET_VALUE: 1,
    ) (
        out : curSID,
        r#in: nextSID,
        clk : port.clk,
        rst : port.rst,
    );

    var predNextPC: PC_Path;
    var nextStage: FetchStageRegPath [FETCH_WIDTH];

    var stall: logic;
    var clear: logic;
    var regStall: logic;
    var beginStall: logic;
    var writePC_FromOuter: logic;

    always_ff (port.clk) {
        if port.rst {
            regStall = FALSE;
        } else {
            regStall = stall;
        }
    }

    // Pipeline Control
    always_comb {
        // Control
        stall = ctrl.npStage.stall;
        clear = ctrl.npStage.clear;
        ctrl.npStageSendBubbleLower = FALSE;

        beginStall = !regStall && stall;

        // Whether PC is written from outside
        if recovery.toRecoveryPhase || recovery.recoverFromRename || port.interruptAddrWE {
            writePC_FromOuter = TRUE;
        } else {
            writePC_FromOuter = FALSE;
        }

        // Update PC if not stalled.
        // NOTE: Update even during stall in the next cases:
        //   1) if PC is written from outside
        //   2) if it is beginning of stall
        //   (see the comment of regBrPred in FetchStage.sv)
        port.pcWE = (writePC_FromOuter || !stall || beginStall) && !port.rst;
    }

    // Branch Prediction
    always_comb {
        if recovery.toRecoveryPhase {
            // Branch misprediction or an exception etc. is detected
            // Refetch instruction specified by Rw, Cm stage
            predNextPC = recovery.recoveredPC_FromRwCommit;
        } else if recovery.recoverFromRename {
            // Detect branch misprediction in decode stage
            predNextPC = recovery.recoveredPC_FromRename;
        } else {
            // Use current PC
            predNextPC = port.pcOut;

            var foundBTB: logic;
            foundBTB = FALSE;
            for i in 0..FETCH_WIDTH {
                // Process of branch prediction:
                // If BTB is hit, the instruction is predicted to be a branch.
                // In addition, if the branch is predicted as Taken,
                // the address read from BTB is used as next PC.
                if !foundBTB && !regStall && next.fetchStageIsValid[i] && next.btbHit[i] && next.brPredTaken[i] {
                    // Use PC from BTB
                    predNextPC = next.btbOut[i];
                    foundBTB = TRUE;
                }
            }
        }

        // To Branch predictor
        port.predNextPC = predNextPC;
    }

    // Updating PC
    always_comb {
        if port.interruptAddrWE {
            // When an interrupt occurs, use interrupt address.
            // NOTE: This input can be a critical path.
            // Hence, interrupt address is input to PC first rather than
            // input to the branch predictor directly.
            port.pcIn = port.interruptAddrIn;
        } else if beginStall {
            // Update PC based on the branch prediction result accessed
            // immediately before the stall if it is beginning of stall.
            // (see the comment of regBrPred in FetchStage.sv)
            port.pcIn = predNextPC;
        } else {
            // Increment PC
            port.pcIn = predNextPC + FETCH_WIDTH * INSN_BYTE_WIDTH;

            var foundBoundary: logic;
            foundBoundary = FALSE;
            for i in 1..FETCH_WIDTH {
                if !foundBoundary && StepOverCacheLine(predNextPC, predNextPC + i * INSN_BYTE_WIDTH) {
                    // When PC stepped over the border of cache line, stop there
                    port.pcIn = predNextPC + i * INSN_BYTE_WIDTH;
                    foundBoundary = TRUE;
                }
            }
        }

        for i in 0..FETCH_WIDTH {
            // Generate serial id for dumping
            nextStage[i].sid = curSID + i;
            nextStage[i].pc = predNextPC + i * INSN_BYTE_WIDTH;
            if port.interruptAddrWE || clear || StepOverCacheLine(predNextPC, nextStage[i].pc) {
                nextStage[i].valid = FALSE;
            } else {
                nextStage[i].valid = TRUE;
            }
        }

        port.nextStage = nextStage;
    }

    // I-cache Access
    var fetchAddr: AddrPath;
    always_comb {
        // Decide input address of I-cache
        if next.fetchStageIsValid[0] && stall {
            // Use the PC of the IF stage
            fetchAddr = ToAddrFromPC(next.fetchStagePC[0]);
        } else {
            // Use the PC of this stage
            fetchAddr = ToAddrFromPC(predNextPC);
        }

        // To I-cache
        port.icNextReadAddrIn = ToPhyAddrFromLogical(fetchAddr);
    }

    var numValidInsns: logic<FETCH_WIDTH + 1>;

    always_comb {
        // Count valid instructions in this stage
        numValidInsns = 0;
        var foundInvalid: logic;
        foundInvalid = FALSE;
        for i in 0..FETCH_WIDTH {
            if !foundInvalid {
                if !nextStage[i].valid {
                    foundInvalid = TRUE;
                } else {
                    numValidInsns = numValidInsns + 1;
                }
            }
        }

        // Update serial ID.
        if stall || clear {
            nextSID = curSID;
        } else {
            nextSID = curSID + numValidInsns;
        }

        // --- Debug Register
        for i in 0..FETCH_WIDTH {
            if stall {
                debug.npReg[i].valid = FALSE;
            } else {
                debug.npReg[i].valid = nextStage[i].valid;
            }
            debug.npReg[i].sid = nextStage[i].sid;
        }
    }
}
