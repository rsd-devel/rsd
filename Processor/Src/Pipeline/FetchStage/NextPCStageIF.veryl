interface NextPCStageIF {
    import BasicTypes::*;
    import PipelineTypes::*;
    import FetchUnitTypes::*;
    import MemoryMapTypes::*;

    var clk     : clock;
    var rst     : logic;
    var rstStart: logic;

    var pcWE : logic;
    var pcOut: PC_Path;
    var pcIn : PC_Path;

    var predNextPC: PC_Path;

    var brResult: BranchResult [INT_ISSUE_WIDTH];

    var interruptAddrIn: PC_Path;
    var interruptAddrWE: logic;

    var icNextReadAddrIn: PhyAddrPath;

    var nextStage: FetchStageRegPath [FETCH_WIDTH];

    modport PC {
        clk  : input ,
        rst  : input ,
        pcWE : input ,
        pcIn : input ,
        pcOut: output,
    }

    modport ThisStage {
        clk             : input ,
        rst             : input ,
        pcOut           : input ,
        brResult        : input ,
        interruptAddrIn : input ,
        interruptAddrWE : input ,
        pcWE            : output,
        pcIn            : output,
        predNextPC      : output,
        icNextReadAddrIn: output,
        nextStage       : output,
    }

    modport NextStage {
        predNextPC: input,
        nextStage : input,
    }

    modport IntegerRegisterWriteStage {
        brResult: output,
    }

    modport BTB {
        clk       : input,
        rst       : input,
        rstStart  : input,
        predNextPC: input,
        brResult  : input,
    }

    modport BranchPredictor {
        clk       : input,
        rst       : input,
        rstStart  : input,
        predNextPC: input,
        brResult  : input,
    }

    modport ICache {
        clk             : input,
        rst             : input,
        rstStart        : input,
        icNextReadAddrIn: input,
    }

    modport InterruptController {
        pcOut          : input ,
        interruptAddrIn: output,
        interruptAddrWE: output,
    }
}
