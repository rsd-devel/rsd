// Pick micro ops for feeding to a next stage from all decoded micro ops.
module MicroOpPicker (
    req        : input AllDecodedMicroOpPath,
    serialize  : input AllDecodedMicroOpPath,
    picked     : output logic [DECODE_WIDTH],
    pickedIndex: output AllDecodedMicroOpIndex [DECODE_WIDTH],
    next       : output AllDecodedMicroOpPath,
) {
    import BasicTypes::*;
    import MicroOpTypes::*;

    var clear: logic;
    var sent : logic;
    var cur  : AllDecodedMicroOpPath;

    always_comb {
        clear = FALSE;
        sent = FALSE;
        cur = req;

        for i in 0..DECODE_WIDTH {
            var found: logic;
            found = FALSE;
            picked[i] = FALSE;
            pickedIndex[i] = 0;

            for mn in 0..ALL_DECODED_MICRO_OP_WIDTH {
                if !found && cur[mn] && !clear {
                    // If this op is serialized one, only a single op is picked.
                    if serialize[mn] {
                        clear = TRUE;
                    }

                    // 既に通常命令を送っている場合，このシリアライズ命令はピックしない
                    if clear && sent {
                        found = TRUE;
                    } else {
                        sent = TRUE;
                        picked[i] = TRUE;
                        pickedIndex[i] = mn;
                        cur[mn] = FALSE;
                        found = TRUE;
                    }
                }
            }
        }

        next = cur;
    }
}

module DecodeStage (
    port       : modport DecodeStageIF::ThisStage,
    prev       : modport PreDecodeStageIF::NextStage,
    ctrl       : modport ControllerIF::DecodeStage,
    debug      : modport DebugIF::DecodeStage,
    perfCounter: modport PerformanceCounterIF::DecodeStage,
) {
    import BasicTypes::*;
    import MemoryMapTypes::*;
    import OpFormatTypes::*;
    import MicroOpTypes::*;
    import PipelineTypes::*;
    import DebugTypes::*;
    import FetchUnitTypes::*;

    var pipeReg: DecodeStageRegPath [DECODE_WIDTH];

    // NOT_TRANSPILED_TO_VERYL
    // Non-synthesis initial debug initialization was not transpilable to native Veryl initial syntax.


    always_ff (port.clk) {
        if port.rst {
            for i in 0..DECODE_WIDTH {
                pipeReg[i].valid = FALSE;
            }
        } else if !ctrl.idStage.stall {
            pipeReg = prev.nextStage;
        }
    }

    var stall: logic;
    var clear: logic;
    var empty: logic;
    var nextStage: RenameStageRegPath [DECODE_WIDTH];

    // Micro-op decoder
    var microOps: OpInfo [ALL_DECODED_MICRO_OP_WIDTH];
    var insnInfo: InsnInfo<DECODE_WIDTH>;

    always_comb {
        for i in 0..DECODE_WIDTH {
            for j in 0..MICRO_OP_MAX_NUM {
                microOps[i * MICRO_OP_MAX_NUM + j] = pipeReg[i].microOps[j];
            }
            insnInfo[i] = pipeReg[i].insnInfo;
        }

        empty = TRUE;
        for i in 0..DECODE_WIDTH {
            if pipeReg[i].valid {
                empty = FALSE;
            }
        }
        ctrl.idStageEmpty = empty;
    }

    var initiate: logic;
    var complete: logic;

    // Early branch misprediction detection.
    var isfIn: RISCV_ISF_Common<DECODE_WIDTH>;
    var stallBranchResolver: logic;
    var insnValidIn: logic [DECODE_WIDTH];
    var brPredIn: BranchPred<DECODE_WIDTH>;
    var pcIn: PC_Path [DECODE_WIDTH];

    var insnValidOut: logic [DECODE_WIDTH];
    var insnFlushed: logic [DECODE_WIDTH];
    var insnFlushTriggering: logic [DECODE_WIDTH];
    var flushTriggered: logic;
    var brPredOut: BranchPred [DECODE_WIDTH];
    var recoveredPC: PC_Path;

    always_comb {
        stallBranchResolver = ctrl.idStage.stall && !ctrl.stallByDecodeStage;
        for i in 0..DECODE_WIDTH {
            insnValidIn[i] = pipeReg[i].valid;
            isfIn[i] = pipeReg[i].insn;
            pcIn[i] = pipeReg[i].pc;
            brPredIn[i] = pipeReg[i].brPred;
        }
    }

    inst decodeStageBranchResolver: DecodedBranchResolver (
        clk                : port.clk,
        rst                : port.rst,
        stall              : stallBranchResolver,
        decodeComplete     : complete,
        insnValidIn        : insnValidIn,
        isf                : isfIn,
        brPredIn           : brPredIn,
        pc                 : pcIn,
        insnInfo           : insnInfo,
        insnValidOut       : insnValidOut,
        insnFlushed        : insnFlushed,
        insnFlushTriggering: insnFlushTriggering,
        flushTriggered     : flushTriggered,
        brPredOut          : brPredOut,
        recoveredPC        : recoveredPC,
    );

    always_comb {
        port.nextFlush = complete && flushTriggered && !clear;
        port.nextRecoveredPC = recoveredPC;
    }

    var remainingValidMOps: AllDecodedMicroOpPath;
    var nextValidMOps: AllDecodedMicroOpPath;
    var curValidMOps: AllDecodedMicroOpPath;
    var pickedValidMOps: AllDecodedMicroOpPath;
    var serializedMOps: AllDecodedMicroOpPath;

    var mopPickedIndex: AllDecodedMicroOpIndex [DECODE_WIDTH];
    var mopPicked: logic [DECODE_WIDTH];

    always_ff (port.clk) {
        if port.rst || ctrl.idStage.clear {
            remainingValidMOps = 0;
            initiate = TRUE;
        } else {
            if !(ctrl.idStage.stall && !ctrl.stallByDecodeStage) {
                initiate = complete;
                remainingValidMOps = nextValidMOps;
            }
        }
    }

    always_comb {
        //
        // Setup current valid bits(=un-decoded bits).
        //
        if initiate {
            for i in 0..ALL_DECODED_MICRO_OP_WIDTH {
                curValidMOps[i] = microOps[i].valid;
            }
        } else {
            curValidMOps = remainingValidMOps;
        }

        // Set a "serialized" flag for each micro op.
        for i in 0..ALL_DECODED_MICRO_OP_WIDTH {
            serializedMOps[i] = microOps[i].serialized;
        }
    }

    inst picker: MicroOpPicker (
        req        : curValidMOps,
        serialize  : serializedMOps,
        picked     : mopPicked,
        pickedIndex: mopPickedIndex,
        next       : pickedValidMOps,
    );

    always_comb {
        // --- The picker picks micro ops

        // Set picked results.
        nextValidMOps = pickedValidMOps;

        complete = TRUE;
        for i in 0..DECODE_WIDTH {
            for j in 0..MICRO_OP_MAX_NUM {
                if nextValidMOps[i * MICRO_OP_MAX_NUM + j] && insnValidIn[i] {
                    complete = FALSE;
                }
            }

            // "complete" does not care "insnValidOut" because "insnValidOut" is in
            // a critical path.
            if !insnValidOut[i] {
                for j in 0..MICRO_OP_MAX_NUM {
                    nextValidMOps[i * MICRO_OP_MAX_NUM + j] = FALSE;
                }
            }
        }

        // Stall decision
        ctrl.idStageStallUpper = !complete;

        stall = ctrl.idStage.stall;
        clear = ctrl.idStage.clear;

        // Pick decoded micro ops.
        for i in 0..DECODE_WIDTH {
            var orgPickedInsnLane: DecodeLaneIndexPath;
            orgPickedInsnLane = mopPickedIndex[i] / MICRO_OP_MAX_NUM;

            nextStage[i].opInfo = microOps[mopPickedIndex[i]];
            nextStage[i].valid = insnValidOut[orgPickedInsnLane] && mopPicked[i] && !clear;
            nextStage[i].pc = pipeReg[orgPickedInsnLane].pc;
            nextStage[i].bPred = brPredOut[orgPickedInsnLane];
            nextStage[i].opId.sid = pipeReg[orgPickedInsnLane].sid;
            nextStage[i].opId.mid = nextStage[i].opInfo.mid;
        }

        port.nextStage = nextStage;

        perfCounter.branchPredMissDetectedOnDecode = complete && flushTriggered && !clear;

        // Debug Register
        for i in 0..DECODE_WIDTH {
            // 先頭が次に送られたら，デコード元は消える．
            debug.idReg[i].valid = pipeReg[i].valid;
            debug.idReg[i].flushed = insnFlushed[i];
            debug.idReg[i].flushTriggering = insnFlushTriggering[i];

            var foundMid0: logic;
            foundMid0 = FALSE;
            for j in 0..MICRO_OP_MAX_NUM {
                if !foundMid0 && microOps[i * MICRO_OP_MAX_NUM + j].valid && microOps[i * MICRO_OP_MAX_NUM + j].mid == 0 {
                    if !curValidMOps[i * MICRO_OP_MAX_NUM + j] {
                        debug.idReg[i].valid = FALSE;
                    }
                    foundMid0 = TRUE;
                }
            }

            debug.idReg[i].opId.sid = pipeReg[i].sid;
            debug.idReg[i].opId.mid = 0;
            debug.idReg[i].pc = ToAddrFromPC(pipeReg[i].pc);
            debug.idReg[i].insn = pipeReg[i].insn;

            debug.idReg[i].undefined = FALSE;
            debug.idReg[i].unsupported = FALSE;
            for j in 0..MICRO_OP_MAX_NUM {
                debug.idReg[i].undefined =
                    debug.idReg[i].undefined | microOps[i * MICRO_OP_MAX_NUM + j].undefined;
                debug.idReg[i].unsupported =
                    debug.idReg[i].unsupported | microOps[i * MICRO_OP_MAX_NUM + j].unsupported;
            }
        }
    }
}
