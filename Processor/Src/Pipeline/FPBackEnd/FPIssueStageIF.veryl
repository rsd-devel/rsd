interface FPIssueStageIF {
    import BasicTypes::*;
    import PipelineTypes::*;

    var clk      : clock;
    var rst      : logic;
    var nextStage: FPRegisterReadStageRegPath [FP_ISSUE_WIDTH];

    modport ThisStage {
        clk      : input ,
        rst      : input ,
        nextStage: output,
    }

    modport NextStage {
        nextStage: input,
    }
}
