interface FPRegisterReadStageIF {
    import BasicTypes::*;
    import PipelineTypes::*;

    var clk      : clock;
    var rst      : logic;
    // Pipeline register
    var nextStage: FPExecutionStageRegPath [FP_ISSUE_WIDTH];

    modport ThisStage {
        clk      : input ,
        rst      : input ,
        nextStage: output,
    }

    modport NextStage {
        nextStage: input,
    }
}
