//
// --- PreDecodeStageIF
//

interface PreDecodeStageIF {
    import BasicTypes::*;
    import PipelineTypes::*;
    import MicroOpTypes::*;

    var clk      : clock;
    var rst      : logic;
    // Pipeline registers
    var nextStage: DecodeStageRegPath [DECODE_WIDTH];

    modport ThisStage {
        clk      : input ,
        rst      : input ,
        nextStage: output,
    }

    modport NextStage {
        nextStage: input,
    }
}
