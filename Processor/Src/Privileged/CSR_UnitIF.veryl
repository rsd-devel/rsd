interface CSR_UnitIF {
    import BasicTypes::*;
    import MemoryMapTypes::*;
    import OpFormatTypes::*;
    import MicroOpTypes::*;
    import SchedulerTypes::*;
    import ActiveListIndexTypes::*;
    import CSR_UnitTypes::*;

    var clk               : clock;
    var rst               : logic;
    var rstStart          : logic;
    var reqCustomInterrupt: logic;
    var customInterruptCode: CustomInterruptCodePath;

    var csrWE      : logic; // CSR write enable
    var csrNumber  : CSR_NumberPath; // CSR number
    var csrCode    : CSR_Code; // CSR operation code (ex. set, clear...)
    var csrReadOut : DataPath; // a register value read from CSR
    var csrWriteIn : DataPath; // a value to be written to CSR
    var csrWholeOut: CSR_BodyPath; // whole values of CSR

    // Exception = trap or fault
    // Trap request
    var triggerExcpt      : logic;
    var excptCause        : ExecutionState;
    var excptCauseAddr    : PC_Path; // EBREAK/ECALL 時の mepc
    var excptTargetAddr   : AddrPath; // Trap vector or xRET return target
    var excptCauseDataAddr: AddrPath; // fault 発生時のデータアドレス
    var csrUnitTriggerExcpt: logic; // CSRへのアクセスが例外を発生させるかどうか

    // Interrupt
    var triggerInterrupt: logic;
    var interruptCode   : CSR_CAUSE_InterruptCodePath;
    var interruptRetAddr: PC_Path;

    // Timer interrupt request
    var reqTimerInterrupt: logic;

    // Used in updating minstret
    var commitNum: CommitLaneCountPath;

    var privilegeLevel: PrivilegeLevelType;

    var fflags   : FFlags_Path;
    var frm      : Rounding_Mode;
    var fflagsWE : logic;
    var fflagsData: FFlags_Path;

    modport MemoryExecutionStage {
        clk: input,
        rst: input,
        rstStart: input,
        csrWholeOut: input,
        csrReadOut: input,
        csrUnitTriggerExcpt: input,
        privilegeLevel: input,
        csrWE: output,
        csrNumber: output,
        csrCode: output,
        csrWriteIn: output,
    }

    modport FPExecutionStage {
        frm: input,
    }

    // 割り込みは以下の流れで要求が流れる
    // IO_Unit -> reqTimerInterrupt ->
    // CSR_Unit -> csrReg.mie.MTIE ->
    // InterruptController -> triggerInterrupt ->
    // FetchStage and CSR_Unit
    modport IO_Unit {
        reqTimerInterrupt: output,
    }

    // For counter update
    modport CommitStage {
        fflags: input,
        commitNum: output,
        fflagsWE: output,
        fflagsData: output,
    }

    modport RecoveryManager {
        excptTargetAddr: input,
        triggerExcpt: output,
        excptCauseAddr: output,
        excptCause: output,
        excptCauseDataAddr: output,
    }

    modport CSR_Unit {
        clk: input,
        rst: input,
        rstStart: input,
        csrWE: input,
        csrNumber: input,
        csrCode: input,
        csrWriteIn: input,
        triggerExcpt: input,
        excptCauseAddr: input,
        excptCause: input,
        excptCauseDataAddr: input,
        commitNum: input,
        reqTimerInterrupt: input,
        reqCustomInterrupt: input,
        customInterruptCode: input,
        triggerInterrupt: input,
        interruptCode: input,
        interruptRetAddr: input,
        fflagsWE: input,
        fflagsData: input,
        fflags: output,
        frm: output,
        csrWholeOut: output,
        csrReadOut: output,
        csrUnitTriggerExcpt: output,
        excptTargetAddr: output,
        privilegeLevel: output,
    }

    modport InterruptController {
        clk: input,
        rst: input,
        rstStart: input,
        csrWholeOut: input,
        privilegeLevel: input,
        triggerInterrupt: output,
        interruptRetAddr: output,
        interruptCode: output,
    }
}
