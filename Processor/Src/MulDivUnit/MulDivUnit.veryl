module MulDivUnit (
    port        : modport MulDivUnitIF::MulDivUnit,
    recovery    : modport RecoveryManagerIF::MulDivUnit,
    registerFile: modport RegisterFileIF::MulDivUnit,
    activeList  : modport ActiveListIF::MulDivUnit,
) {
    //
    // Complex Integer Execution stage
    //
    // 乗算/SIMD 命令の演算を行う
    // COMPLEX_EXEC_STAGE_DEPTH 段にパイプライン化されている
    //

    import BasicTypes::*;
    import OpFormatTypes::*;
    import ActiveListIndexTypes::*;
    import MulDivUnitTypes::*;
    import SchedulerTypes::*;

    for i in 0..MULDIV_ISSUE_WIDTH : BlockMulUnit {
        // MultiplierUnit
        inst mulUnit: PipelinedMultiplierUnit #(
            BIT_WIDTH     : DATA_WIDTH,
            PIPELINE_DEPTH: MULDIV_STAGE_DEPTH,
        ) (
            clk      : port.clk,
            stall    : port.stall,
            fuOpA_In : port.dataInA[i],
            fuOpB_In : port.dataInB[i],
            getUpper : port.mulGetUpper[i],
            mulCode  : port.mulCode[i],
            dataOut  : port.mulDataOut[i],
        );
    }

    //
    // DividerUnit
    //

    enum DividerPhase: logic<2> {
        DIVIDER_PHASE_FREE = 0,              // Divider is free
        DIVIDER_PHASE_RESERVED = 1,          // Divider is not processing but reserved
        DIVIDER_PHASE_PROCESSING = 2,        // In processing
        DIVIDER_PHASE_REGISTER_WRITE = 3,    // Write result to RegisterFile and ActiveList
    }

    var regPhase: DividerPhase [MULDIV_ISSUE_WIDTH];
    var nextPhase: DividerPhase [MULDIV_ISSUE_WIDTH];
    var finished: logic [MULDIV_ISSUE_WIDTH];
    var divDataOut: DataPath [MULDIV_ISSUE_WIDTH];

    var rst_divider: logic [MULDIV_ISSUE_WIDTH];
    var regAcquireData: MulDivAcquireData [MULDIV_ISSUE_WIDTH];
    var nextAcquireData: MulDivAcquireData [MULDIV_ISSUE_WIDTH];

    for i in 0..MULDIV_ISSUE_WIDTH : BlockDivUnit {
        inst divUnit: DividerUnit (
            clk      : port.clk,
            rst      : rst_divider[i],
            req      : port.divReq[i],
            fuOpA_In : port.dataInA[i],
            fuOpB_In : port.dataInB[i],
            divCode  : port.divCode[i],
            finished : finished[i],
            dataOut  : divDataOut[i],
        );
    }

    always_ff (port.clk) {
        if port.rst {
            for i in 0..MULDIV_ISSUE_WIDTH {
                regPhase[i] = DividerPhase::DIVIDER_PHASE_FREE;
                regAcquireData[i] = '0;
            }
        } else {
            regPhase = nextPhase;
            regAcquireData = nextAcquireData;
        }
    }

    always_comb {
        for i in 0..MULDIV_ISSUE_WIDTH {
            var nextPhaseValue: DividerPhase;
            var nextAcquireDataValue: MulDivAcquireData;
            var flushValue: logic;
            var divWriteDataValue: ActiveListWriteData;
            var divDstRegDataValue: PRegDataPath;

            nextPhaseValue = regPhase[i];
            nextAcquireDataValue = regAcquireData[i];
            divWriteDataValue = '0;
            divDstRegDataValue = '0;

            // register
            registerFile.divDstRegWE[i] = FALSE;
            registerFile.divDstRegNum[i] = '0;
            registerFile.divDstRegData[i] = '0;
            // ActiveList
            activeList.divWrite[i] = FALSE;
            activeList.divWriteData[i] = '0;

            case regPhase[i] {
                default: {
                    nextPhaseValue = DividerPhase::DIVIDER_PHASE_FREE;
                }
                DividerPhase::DIVIDER_PHASE_FREE: {
                    // Reserve divider and do not issue any div after that.
                    if port.divAcquire[i] {
                        nextPhaseValue = DividerPhase::DIVIDER_PHASE_RESERVED;
                        nextAcquireDataValue = port.acquireData[i];
                    }
                }
                DividerPhase::DIVIDER_PHASE_RESERVED: {
                    // Request to the divider
                    // NOT make a request when below situation
                    // 1) When any operands of inst. are invalid
                    // 2) When the divider is waiting for the instruction
                    //    to receive the result of the divider
                    if port.divReq[i] {
                        // Receive the request of div,
                        // so move to processing phase
                        nextPhaseValue = DividerPhase::DIVIDER_PHASE_PROCESSING;
                    }
                }
                DividerPhase::DIVIDER_PHASE_PROCESSING: {
                    // Div operation has finished, so we can get result from divider
                    if finished[i] {
                        nextPhaseValue = DividerPhase::DIVIDER_PHASE_REGISTER_WRITE;
                    }
                }
                DividerPhase::DIVIDER_PHASE_REGISTER_WRITE: {
                    nextPhaseValue = DividerPhase::DIVIDER_PHASE_FREE;

                    divDstRegDataValue.valid = TRUE;
                    divDstRegDataValue.data = divDataOut[i];

                    // register
                    registerFile.divDstRegWE[i] = regAcquireData[i].opDst.writeReg;
                    registerFile.divDstRegNum[i] = regAcquireData[i].opDst.phyDstRegNum;
                    registerFile.divDstRegData[i] = divDstRegDataValue;

                    // ActiveList
                    divWriteDataValue.ptr = regAcquireData[i].activeListPtr;
                    divWriteDataValue.state = EXEC_STATE_SUCCESS;
                    activeList.divWrite[i] = TRUE;
                    activeList.divWriteData[i] = divWriteDataValue;
                }
            }

            flushValue = SelectiveFlushDetector(
                recovery.toRecoveryPhase,
                recovery.flushRangeHeadPtr,
                recovery.flushRangeTailPtr,
                recovery.flushAllInsns,
                regAcquireData[i].activeListPtr
            );

            // Cancel divider allocation on pipeline flush
            if flushValue {
                // 除算器に要求したdivがフラッシュされたら、レジスタとActiveListへの書き込みもキャンセルする
                registerFile.divDstRegWE[i] = FALSE;
                activeList.divWrite[i] = FALSE;
                // 除算器に要求をしたdivがフラッシュされたので，除算器を解放する
                nextPhaseValue = DividerPhase::DIVIDER_PHASE_FREE;
            }

            rst_divider[i] = port.rst | flushValue;

            // 現状 acquire が issue ステージからくるので，次のサイクルの状態でフリーか
            // どうかを判定する必要がある
            if nextPhaseValue == DividerPhase::DIVIDER_PHASE_FREE {
                port.divFree[i] = TRUE;
            } else {
                port.divFree[i] = FALSE;
            }

            // ReplayQueueでdivの完了待ちをしている命令のRRが
            // ちょうどレジスタの値を読み込めるようになるタイミングにするためにnextPhaseを使う
            if nextPhaseValue == DividerPhase::DIVIDER_PHASE_PROCESSING {
                port.divBusy[i] = TRUE;
            } else {
                port.divBusy[i] = FALSE;
            }

            if regPhase[i] == DividerPhase::DIVIDER_PHASE_RESERVED {
                port.divReserved[i] = TRUE;
            } else {
                port.divReserved[i] = FALSE;
            }

            nextPhase[i] = nextPhaseValue;
            nextAcquireData[i] = nextAcquireDataValue;
        }
    }
}
