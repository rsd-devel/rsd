//
// Dependency matrix.
//

module ProducerMatrix (
    clk                  : input  clock                                                                                                                                                   ,
    dispatch             : input  logic                                                                                                          [DISPATCH_WIDTH]                         ,
    dispatchedSrcRegReady: input  logic                                                                                                          [DISPATCH_WIDTH, ISSUE_QUEUE_SRC_REG_NUM],
    dispatchedSrcRegPtr  : input  logic                               <DISPATCH_WIDTH, ISSUE_QUEUE_SRC_REG_NUM, ISSUE_QUEUE_ENTRY_NUM_BIT_WIDTH>                                          ,
    dependStoreBitVector : input  SchedulerTypes::IssueQueueOneHotPath                                                                           [DISPATCH_WIDTH]                         ,
    dispatchPtr          : input  SchedulerTypes::IssueQueueIndexPath                                                                            [DISPATCH_WIDTH]                         ,
    wakeupDstVector      : input  SchedulerTypes::IssueQueueOneHotPath                                                                           [WAKEUP_WIDTH]                           ,
    opReady              : output logic                                                                                                          [ISSUE_QUEUE_ENTRY_NUM]                  ,
) {
    import BasicTypes::*;
    import SchedulerTypes::*;

    // ProducerMatrix can be updated without regarding the validness of consumer
    // rows because an outer logic (Scheduler) check their validness.
    var nextMatrix: logic<ISSUE_QUEUE_ENTRY_NUM, ISSUE_QUEUE_ENTRY_NUM>;
    var matrix    : logic<ISSUE_QUEUE_ENTRY_NUM, ISSUE_QUEUE_ENTRY_NUM>; // Don't care.

    // NOT_TRANSPILED_TO_VERYL
    // Don't care these values, but avoiding undefined status in Questa.
    // Non-synthesis initial debug initialization was not transpilable to native Veryl initial syntax.


    always_ff (clk) {
        matrix = nextMatrix;
    }

    var dispatchVector: logic               <DISPATCH_WIDTH, ISSUE_QUEUE_ENTRY_NUM>;
    var wakeupVector  : IssueQueueOneHotPath                                       ;

    always_comb {
        nextMatrix = matrix;

        // Wakeup
        wakeupVector = '0;
        for w in 0..WAKEUP_WIDTH {
            // A producer column can be cleared without regarding to validness of wakeup.
            //if (wakeup[w]) begin
            //end
            // wakeupDstVector determined in WakeupPipelineRegister already contains stall information,
            // so stall check in ProducerMatrix is unnecessary.
            wakeupVector = wakeupVector | wakeupDstVector[w];
        }

        for i in 0..ISSUE_QUEUE_ENTRY_NUM {
            for j in 0..ISSUE_QUEUE_ENTRY_NUM {
                if wakeupVector[j] {
                    nextMatrix[i][j] = FALSE;
                } else {
                    nextMatrix[i][j] = nextMatrix[i][j];
                }
            }
        }

        // It is ready when its all source bits are zero.
        for i in 0..ISSUE_QUEUE_ENTRY_NUM {
            opReady[i] = nextMatrix[i] == '0;
        }

        // Dispatch
        for i in 0..DISPATCH_WIDTH {
            for j in 0..ISSUE_QUEUE_ENTRY_NUM {
                dispatchVector[i][j] = dependStoreBitVector[i][j];
                for k in 0..ISSUE_QUEUE_SRC_REG_NUM {
                    // dispatchedSrcRegReady are from a ready bit table and it includes validness information.
                    if !dispatchedSrcRegReady[i][k] && dispatchedSrcRegPtr[i][k] == j {
                        dispatchVector[i][j] = TRUE;
                    }
                }
            }
        }

        for i in 0..DISPATCH_WIDTH {
            if dispatch[i] {
                nextMatrix[dispatchPtr[i]] = dispatchVector[i];
            }
        }
    }
}
