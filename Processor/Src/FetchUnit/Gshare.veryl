//
// Gshare Branch Predictor
//

package GshareFunctions {
    import BasicTypes::*;
    import MemoryMapTypes::*;
    import FetchUnitTypes::*;

    function ToPHT_Index_Global (
        addr: input PC_Path,
        gh  : input BranchGlobalHistoryPath,
    ) -> PHT_IndexPath {
        var phtIndex: PHT_IndexPath;
        phtIndex =
            addr[
                PHT_ENTRY_NUM_BIT_WIDTH + INSN_ADDR_BIT_WIDTH - 1:
                INSN_ADDR_BIT_WIDTH
            ];
        phtIndex[PHT_ENTRY_NUM_BIT_WIDTH - 1:PHT_ENTRY_NUM_BIT_WIDTH - BRANCH_GLOBAL_HISTORY_BIT_WIDTH] =
            phtIndex[PHT_ENTRY_NUM_BIT_WIDTH - 1:PHT_ENTRY_NUM_BIT_WIDTH - BRANCH_GLOBAL_HISTORY_BIT_WIDTH] ^ gh;
        return phtIndex;
    }
}

module Gshare (
    port: modport NextPCStageIF::BranchPredictor,
    next: modport FetchStageIF::BranchPredictor,
    ctrl: modport ControllerIF::BranchPredictor,
) {
    import BasicTypes::*;
    import MemoryMapTypes::*;
    import FetchUnitTypes::*;
    import GshareFunctions::*;

    var stall: logic;
    var clear: logic;
    var pcIn: PC_Path;

    // Logic for read/write PHT
    var phtWE: logic [INT_ISSUE_WIDTH];
    var phtWA: PHT_IndexPath [INT_ISSUE_WIDTH];
    var phtWV: PHT_EntryPath [INT_ISSUE_WIDTH];
    // Read port need for branch predict and update counter.
    var phtRA: PHT_IndexPath [FETCH_WIDTH];
    var phtRV: PHT_EntryPath [FETCH_WIDTH];

    // Branch history for using predict.
    var nextBrGlobalHistory: BranchGlobalHistoryPath;
    var regBrGlobalHistory: BranchGlobalHistoryPath;
    var brGlobalHistory: BranchGlobalHistoryPath [FETCH_WIDTH];

    // assert when misprediction occured.
    var mispred: logic;
    var pushPhtQueue: logic;
    var popPhtQueue: logic;
    var full: logic;
    var empty: logic;

    // Queue for multibank pht
    var phtQueue: PhtQueueEntry [PHT_QUEUE_SIZE];
    var headPtr: PhtQueuePointerPath;
    var tailPtr: PhtQueuePointerPath;
    // Check for write number in 1cycle.
    var updatePht: logic;

    // the body of PHT.
    inst pht: BlockMultiBankRAM #(
        ENTRY_NUM     : PHT_ENTRY_NUM,
        ENTRY_BIT_SIZE: $bits(PHT_EntryPath),
        READ_NUM      : FETCH_WIDTH,
        WRITE_NUM     : INT_ISSUE_WIDTH,
    ) (
        clk: port.clk,
        we : phtWE,
        wa : phtWA,
        wv : phtWV,
        ra : phtRA,
        rv : phtRV,
    );

    inst phtQueuePointer: QueuePointer #(
        SIZE: PHT_QUEUE_SIZE,
    ) (
        clk    : port.clk,
        rst    : port.rst,
        push   : pushPhtQueue,
        pop    : popPhtQueue,
        full   : full,
        empty  : empty,
        headPtr: headPtr,
        tailPtr: tailPtr,
    );

    // Counter for reset sequence.
    var resetIndex: PHT_IndexPath;

    always_ff (port.clk) {
        if port.rstStart {
            resetIndex = 0;
        } else {
            resetIndex = resetIndex + 1;
        }
    }

    always_ff (port.clk) {
        // update Branch Global History.
        if port.rst {
            regBrGlobalHistory = '0;
        } else {
            regBrGlobalHistory = nextBrGlobalHistory;
        }

        // Push Pht Queue
        if port.rst {
            phtQueue[resetIndex % PHT_QUEUE_SIZE].phtWA = '0;
            phtQueue[resetIndex % PHT_QUEUE_SIZE].phtWV = PHT_ENTRY_MAX / 2 + 1;
        } else if pushPhtQueue {
            phtQueue[headPtr].phtWA = phtWA[INT_ISSUE_WIDTH - 1];
            phtQueue[headPtr].phtWV = phtWV[INT_ISSUE_WIDTH - 1];
        }
    }

    always_comb {
        stall = ctrl.ifStage.stall;
        clear = ctrl.ifStage.clear;
        pcIn = port.predNextPC;

        nextBrGlobalHistory = regBrGlobalHistory;

        for i in 0..FETCH_WIDTH {
            next.brPredTaken[i] = FALSE;
            // Output global history to pipeline for recovery.
            brGlobalHistory[i] = regBrGlobalHistory;
        }

        var stopPredict: logic;
        stopPredict = FALSE;
        for i in 0..FETCH_WIDTH {
            var brPredTakenValue: logic;
            var updateHistoryValue: logic;

            brPredTakenValue = FALSE;
            updateHistoryValue = FALSE;
            if !stopPredict {
                // Predict directions (Check the MSB).
                brPredTakenValue = phtRV[i][PHT_ENTRY_WIDTH - 1] && next.btbHit[i];
                // Assert BTB is hit, ICache line is valid, and conditional branch.
                updateHistoryValue = next.btbHit[i] && next.readIsCondBr[i] && next.updateBrHistory[i];
                next.brPredTaken[i] = brPredTakenValue;

                if updateHistoryValue {
                    // Shift history 1 bit to the left and reflect prediction direction in LSB.
                    nextBrGlobalHistory = (nextBrGlobalHistory << 1) | brPredTakenValue;
                    if brPredTakenValue {
                        // If brPred is taken, next instruction don't be executed.
                        stopPredict = TRUE;
                    }
                }
            }
        }

        next.phtPrevValue = phtRV;
        next.brGlobalHistory = brGlobalHistory;

        // Discard the result of previous cycle
        for i in 0..INT_ISSUE_WIDTH {
            phtWE[i] = FALSE;
            phtWV[i] = '0;
            phtWA[i] = ToPHT_Index_Global(
                port.brResult[i].brAddr,
                port.brResult[i].globalHistory
            );
        }

        updatePht = FALSE;
        pushPhtQueue = FALSE;

        for i in 0..INT_ISSUE_WIDTH {
            var phtPrevValueValue: PHT_EntryPath;

            // Counter's value.
            phtPrevValueValue = port.brResult[i].phtPrevValue;
            // When branch instruction is executed, update PHT.
            if updatePht {
                pushPhtQueue = port.brResult[i].valid;
            } else {
                phtWE[i] = port.brResult[i].valid;
                updatePht = updatePht | phtWE[i];
            }

            mispred = port.brResult[i].mispred && port.brResult[i].valid;

            // Update PHT's counter (saturated up/down counter).
            if port.brResult[i].execTaken {
                if phtPrevValueValue == PHT_ENTRY_MAX {
                    phtWV[i] = PHT_ENTRY_MAX;
                } else {
                    phtWV[i] = phtPrevValueValue + 1;
                }
            } else {
                if phtPrevValueValue == 0 {
                    phtWV[i] = 0;
                } else {
                    phtWV[i] = phtPrevValueValue - 1;
                }
            }

            // When miss prediction is occured, recovory history.
            if mispred {
                if port.brResult[i].isCondBr {
                    nextBrGlobalHistory =
                        (port.brResult[i].globalHistory << 1) | port.brResult[i].execTaken;
                } else {
                    nextBrGlobalHistory = port.brResult[i].globalHistory;
                }
            }
        }

        for i in 0..FETCH_WIDTH {
            // Read PHT entry for next cycle (use PC ^ brGlobalHistory).
            phtRA[i] = ToPHT_Index_Global(
                pcIn + i * INSN_BYTE_WIDTH,
                nextBrGlobalHistory
            );
        }

        // Pop PHT Queue
        if !empty && !updatePht {
            popPhtQueue = TRUE;
            phtWE[0] = TRUE;
            phtWA[0] = phtQueue[tailPtr].phtWA[PHT_ENTRY_NUM_BIT_WIDTH - 1:0];
            phtWV[0] = phtQueue[tailPtr].phtWV;
        } else {
            popPhtQueue = FALSE;
        }

        // In reset sequence, the write port 0 is used for initializing, and
        // the other write ports are disabled.
        if port.rst {
            for i in 0..INT_ISSUE_WIDTH {
                if i == 0 {
                    phtWE[i] = TRUE;
                } else {
                    phtWE[i] = FALSE;
                }
                phtWA[i] = resetIndex;
                phtWV[i] = PHT_ENTRY_MAX / 2 + 1;
            }

            // To avoid writing to the same bank (avoid error message)
            for i in 0..FETCH_WIDTH {
                phtRA[i] = i;
            }

            pushPhtQueue = FALSE;
            popPhtQueue = FALSE;
        }
    }
}
