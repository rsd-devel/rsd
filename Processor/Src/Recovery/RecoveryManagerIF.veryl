// --- RecoveryManagerIF
interface RecoveryManagerIF {
    import BasicTypes::*;
    import PipelineTypes::*;
    import RenameLogicTypes::*;
    import SchedulerTypes::*;
    import ActiveListIndexTypes::*;
    import LoadStoreUnitTypes::*;

    var clk: clock;
    var rst: logic;

    // Phase of a pipeline
    var phase: PipelinePhase;

    // A type of exception from CommitStage
    var refetchTypeFromCommitStage: RefetchType;
    // A type of exception from CommitStage
    var refetchTypeFromRwStage    : RefetchType;
    // Index of detected exception op in CommitStage
    var recoveryOpIndex           : CommitLaneIndexPath;
    // Exception detected in CommitStage
    var exceptionDetectedInCommitStage: logic;
    // Exception detected in RwStage
    var exceptionDetectedInRwStage    : logic;

    // PC control
    var toCommitPhase              : logic;
    var recoveredPC_FromCommitStage: AddrPath;
    var recoveredPC_FromRwStage    : AddrPath;
    // Correct PC
    var recoveredPC_FromRwCommit   : AddrPath;

    // For fault handling
    var faultingDataAddr: AddrPath;

    //　Miss prediction detected in RenameStage
    var recoverFromRename    : logic;
    var recoveredPC_FromRename: AddrPath;

    // Trigger recovery of each module
    var toRecoveryPhase: logic;

    // Flush range to broadcast
    var flushRangeHeadPtr: ActiveListIndexPath;
    var flushRangeTailPtr: ActiveListIndexPath;
    // Whether flush all instructions in ActiveList
    // This is necessary to distinguish when ActiveList is full or empty,
    var flushAllInsns    : logic;

    // ActiveList/LSQ TailPtr for recovery
    var loadQueueRecoveryTailPtr : LoadQueueIndexPath;
    var loadQueueHeadPtr         : LoadQueueIndexPath;
    var storeQueueRecoveryTailPtr: StoreQueueIndexPath;
    var storeQueueHeadPtr        : StoreQueueIndexPath;

    // IssueQueueEntryPtr to be flushed at recovery
    var flushIQ_Entry        : IssueQueueOneHotPath;
    // In IQ returning index to freelist
    var issueQueueReturnIndex: logic;
    // In AL recovery
    var inRecoveryAL         : logic;
    // In RMT recovery
    var renameLogicRecoveryRMT: logic;

    // In ReplayQueue flushing
    var replayQueueFlushedOpExist       : logic;
    // In wakeupPipelineReg flushing
    var wakeupPipelineRegFlushedOpExist : logic;
    // Unable to detect exception and start recovery
    var unableToStartRecovery           : logic;

    // IssueQueueのflushが必要なエントリかどうかの判定に使う
    var notIssued: IssueQueueOneHotPath;

    // wakeupPipelineRegister内の命令のフラッシュに使う
    var selected             : logic [ISSUE_WIDTH];
    var selectedPtr          : IssueQueueIndexPath [ISSUE_WIDTH];
    var selectedActiveListPtr: ActiveListIndexPath [ISSUE_WIDTH];

    // RwStageからのリカバリかどうか
    // toRecoveryPhaseと同時に立ちTrueでないときCommitStageからのリカバリ
    var recoveryFromRwStage: logic;

    // Why recovery is caused
    var recoveryCauseFromCommitStage: ExecutionState;

    modport RecoveryManager {
        clk: input,
        rst: input,
        exceptionDetectedInCommitStage: input,
        refetchTypeFromCommitStage: input,
        exceptionDetectedInRwStage: input,
        refetchTypeFromRwStage: input,
        renameLogicRecoveryRMT: input,
        issueQueueReturnIndex: input,
        replayQueueFlushedOpExist: input,
        wakeupPipelineRegFlushedOpExist: input,
        recoveredPC_FromCommitStage: input,
        recoveredPC_FromRwStage: input,
        faultingDataAddr: input,
        notIssued: input,
        flushIQ_Entry: input,
        recoveryCauseFromCommitStage: input,
        phase: output,
        toRecoveryPhase: output,
        recoveredPC_FromRwCommit: output,
        toCommitPhase: output,
        flushRangeHeadPtr: output,
        flushRangeTailPtr: output,
        unableToStartRecovery: output,
        recoveryFromRwStage: output,
        loadQueueRecoveryTailPtr: output,
        storeQueueRecoveryTailPtr: output,
    }

    modport RenameStage {
        recoverFromRename: output,
        recoveredPC_FromRename: output,
    }

    modport CommitStage {
        phase: input,
        unableToStartRecovery: input,
        renameLogicRecoveryRMT: input,
        exceptionDetectedInCommitStage: output,
        recoveryOpIndex: output,
        refetchTypeFromCommitStage: output,
        recoveryCauseFromCommitStage: output,
    }

    modport NextPCStage {
        toCommitPhase: input,
        toRecoveryPhase: input,
        recoveredPC_FromRwCommit: input,
        recoverFromRename: input,
        recoveredPC_FromRename: input,
    }

    modport RenameLogic {
        toRecoveryPhase: input,
        inRecoveryAL: input,
        renameLogicRecoveryRMT: output,
    }

    modport RenameLogicCommitter {
        toRecoveryPhase: input,
        toCommitPhase: input,
        inRecoveryAL: output,
    }

    modport IssueQueue {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
        notIssued: input,
        selected: input,
        selectedPtr: input,
        recoveryFromRwStage: input,
        flushIQ_Entry: output,
        issueQueueReturnIndex: output,
        selectedActiveListPtr: output,
    }

    modport Scheduler {
        toRecoveryPhase: input,
        flushIQ_Entry: input,
        notIssued: output,
    }

    modport ScheduleStage {
        toRecoveryPhase: input,
        flushIQ_Entry: input,
    }

    modport SelectLogic {
        selected: output,
        selectedPtr: output,
    }

    modport ReplayQueue {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
        recoveryFromRwStage: input,
        replayQueueFlushedOpExist: output,
    }

    modport WakeupPipelineRegister {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
        selectedActiveListPtr: input,
        flushIQ_Entry: input,
        recoveryFromRwStage: input,
        wakeupPipelineRegFlushedOpExist: output,
    }

    modport LoadQueue {
        toRecoveryPhase: input,
        loadQueueRecoveryTailPtr: input,
        loadQueueHeadPtr: output,
    }

    modport StoreQueue {
        toRecoveryPhase: input,
        storeQueueRecoveryTailPtr: input,
        storeQueueHeadPtr: output,
    }

    modport StoreCommitter {
        toRecoveryPhase: input,
    }

    modport DCacheMissHandler {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport MulDivUnit {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport IntegerIssueStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport IntegerRegisterReadStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport IntegerExecutionStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport IntegerRegisterWriteStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport ComplexIntegerIssueStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport ComplexIntegerRegisterReadStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport ComplexIntegerExecutionStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport ComplexIntegerRegisterWriteStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport MemoryIssueStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport MemoryRegisterReadStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport MemoryExecutionStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport MemoryTagAccessStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport MemoryAccessStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport MemoryRegisterWriteStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport FPIssueStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport FPRegisterReadStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport FPExecutionStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport FPRegisterWriteStage {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport FPDivSqrtUnit {
        toRecoveryPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        flushAllInsns: input,
    }

    modport ActiveList {
        toRecoveryPhase: input,
        toCommitPhase: input,
        flushRangeHeadPtr: input,
        flushRangeTailPtr: input,
        unableToStartRecovery: input,
        exceptionDetectedInRwStage: output,
        refetchTypeFromRwStage: output,
        recoveredPC_FromCommitStage: output,
        recoveredPC_FromRwStage: output,
        faultingDataAddr: output,
        flushAllInsns: output,
    }

    modport InterruptController {
        unableToStartRecovery: input,
    }
}
