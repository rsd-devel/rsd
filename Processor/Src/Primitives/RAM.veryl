//
// XOR based LUT RAM.
// "Multi-ported memories for FPGAs via XOR", Laforest, Charles Eric et. al.,
// FPGA 2012
//
module XOR_DistributedMultiPortRAM #(
    param ENTRY_NUM     : u32 = 64,
    param ENTRY_BIT_SIZE: u32 = 63,
    param READ_NUM      : u32 = 8 ,
    param WRITE_NUM     : u32 = 2 ,
