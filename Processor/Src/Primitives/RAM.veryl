        READ_NUM      : READ_NUM      ,
        WRITE_NUM     : WRITE_NUM     ,
    ) (
        clk: clk,
        we : we ,
        wa : wa ,
        wv : wv ,
        ra : ra ,
        rv : rv ,
    );
}

