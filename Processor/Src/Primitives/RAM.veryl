// -- Block RAM configured for READ_FIRST mode.
//
// You can get a read value 1-cycle after you set a read address.
// When you write and read simultaneously, a read value becomes
// the written value .
//
// Simple Dual Port RAM ( 1-read / 1-write )
module BlockDualPortRAM #(
    param ENTRY_NUM     : u32 = 128,
    param ENTRY_BIT_SIZE: u32 = 64 ,
) (
    clk: input  clock                       ,
    we : input  logic                       ,
    wa : input  logic<$clog2(ENTRY_NUM)>    ,
    wv : input  logic<ENTRY_BIT_SIZE>       ,
    ra : input  logic<$clog2(ENTRY_NUM)>    ,
    rv : output logic<ENTRY_BIT_SIZE>       ,
) {
    inst body: $sv::BlockDualPortRAM_SV #(
        ENTRY_NUM     : ENTRY_NUM     ,
        ENTRY_BIT_SIZE: ENTRY_BIT_SIZE,
    ) (
        clk: clk,
        we : we ,
        wa : wa ,
        wv : wv ,
        ra : ra ,
        rv : rv ,
    );
}

// True Dual Port RAM ( 2-read/write )
module BlockTrueDualPortRAM #(
    param ENTRY_NUM     : u32 = 16,
    param ENTRY_BIT_SIZE: u32 = 1 ,
    // Do NOT change this parameter to synthesize True Dual Port RAM
    param PORT_NUM      : u32 = 2 ,
) (
    clk: input  clock                            ,
    we : input  logic                    [PORT_NUM],
    rwa: input  logic<$clog2(ENTRY_NUM)> [PORT_NUM],
    wv : input  logic<ENTRY_BIT_SIZE>    [PORT_NUM],
    rv : output logic<ENTRY_BIT_SIZE>    [PORT_NUM],
) {
    inst body: $sv::BlockTrueDualPortRAM_SV #(
        ENTRY_NUM     : ENTRY_NUM     ,
        ENTRY_BIT_SIZE: ENTRY_BIT_SIZE,
        PORT_NUM      : PORT_NUM      ,
    ) (
        clk: clk,
        we : we ,
        rwa: rwa,
        wv : wv ,
        rv : rv ,
    );
}
module BlockMultiPortRAM #(
    param ENTRY_NUM     : u32 = 4,
    param ENTRY_BIT_SIZE: u32 = 8,
    param READ_NUM      : u32 = 2,
    param WRITE_NUM     : u32 = 2,
) (
    clk: input  clock                             ,
    we : input  logic                    [WRITE_NUM],
    wa : input  logic<$clog2(ENTRY_NUM)> [WRITE_NUM],
    wv : input  logic<ENTRY_BIT_SIZE>    [WRITE_NUM],
    ra : input  logic<$clog2(ENTRY_NUM)> [READ_NUM] ,
    rv : output logic<ENTRY_BIT_SIZE>    [READ_NUM] ,
) {
    inst body: $sv::BlockMultiPortRAM_SV #(
        ENTRY_NUM     : ENTRY_NUM     ,
        ENTRY_BIT_SIZE: ENTRY_BIT_SIZE,
        READ_NUM      : READ_NUM      ,
        WRITE_NUM     : WRITE_NUM     ,
    ) (
        clk: clk,
        we : we ,
        wa : wa ,
        wv : wv ,
        ra : ra ,
        rv : rv ,
    );
}

//
// BlockRAM initialized at power-on
// Initialization is NOT performed at reset
//
module InitializedBlockRAM #(
    param ENTRY_NUM     : u32    = 128       ,
    param ENTRY_BIT_SIZE: u32    = 64        ,
    param INIT_HEX_FILE : string = "code.hex",
) (
    clk: input  clock                       ,
    we : input  logic                       ,
    wa : input  logic<$clog2(ENTRY_NUM)>    ,
    wv : input  logic<ENTRY_BIT_SIZE>       ,
    ra : input  logic<$clog2(ENTRY_NUM)>    ,
    rv : output logic<ENTRY_BIT_SIZE>       ,
) {
    inst body: $sv::InitializedBlockRAM_SV #(
        ENTRY_NUM     : ENTRY_NUM     ,
        ENTRY_BIT_SIZE: ENTRY_BIT_SIZE,
        INIT_HEX_FILE : INIT_HEX_FILE ,
    ) (
        clk: clk,
        we : we ,
        wa : wa ,
        wv : wv ,
        ra : ra ,
        rv : rv ,
    );
}

