//
// MemoryReadReqQueue
//

module MemoryReadReqQueue (
    clk       : input  clock        ,
    rst       : input  logic        ,
    push      : input  logic        ,
    pop       : input  logic        ,
    pushedData: input  MemoryReadReq,
    full      : output logic        ,
    empty     : output logic        ,
    headData  : output MemoryReadReq,
) {
    import MemoryTypes::*;

    inst body: $sv::MemoryReadReqQueue_SV (
        clk       : clk       ,
        rst       : rst       ,
        push      : push      ,
        pop       : pop       ,
        pushedData: pushedData,
        full      : full      ,
        empty     : empty     ,
        headData  : headData  ,
    );
}
