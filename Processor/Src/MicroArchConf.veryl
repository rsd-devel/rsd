package MicroArchConf {
    // ---- Front-end
    // Fetch width (instructions). This parameter is configurable.
    const CONF_FETCH_WIDTH: u32 = 2;

    // These parameters cannot be changed and currently must be equal to FETCH_WIDTH.
    const CONF_DECODE_WIDTH  : u32 = CONF_FETCH_WIDTH;
    const CONF_RENAME_WIDTH  : u32 = CONF_FETCH_WIDTH;
    const CONF_DISPATCH_WIDTH: u32 = CONF_FETCH_WIDTH;

    // ---- Commit
    // Commit width (instructions). This parameter is configurable.
    // must be equal or larger than RENAME_WIDTH (FETCH_WIDTH) for recovery
    const CONF_COMMIT_WIDTH: u32 = 2;

    // --- Back-end
    // The number of physical registers
    // INT and FP must be the same at present.
    const CONF_PSCALAR_NUM   : u32 = 64;
    const CONF_PSCALAR_FP_NUM: u32 = 64;

    // The number of issue-queue entries
    const CONF_ISSUE_QUEUE_ENTRY_NUM : u32 = 16;

    // The number of active-list (ROB: reorder buffer) entries
    const CONF_ACTIVE_LIST_ENTRY_NUM : u32 = 64;

    // The number of replay-queue entries
    const CONF_REPLAY_QUEUE_ENTRY_NUM: u32 = 20;

    // The issue width of integer pipelines.
    // CONF_INT_ISSUE_WIDTH must be 1 or 2
    // Matches the default RSD_SRC_CFG in Makefiles/CoreSources.inc.mk.
    const CONF_INT_ISSUE_WIDTH    : u32 = 2;

    // The issue width of complex pipelines.
    // CONF_COMPLEX_ISSUE_WIDTH must be zero or one and cannot be changed manually.
    const CONF_COMPLEX_ISSUE_WIDTH: u32 = 1;

    // The issue width of memory pipelines.
    // These parameters cannot be changed manually.
    const CONF_LOAD_ISSUE_WIDTH      : u32 = 1;
    const CONF_STORE_ISSUE_WIDTH     : u32 = 1;
    const CONF_MEM_ISSUE_WIDTH       : u32 = 2;
    // Store uses a dedicated lane
    const CONF_STORE_ISSUE_LANE_BEGIN: u32 = CONF_LOAD_ISSUE_WIDTH;

    // The issue width of fp pipelines.
    const CONF_FP_ISSUE_WIDTH: u32 = 1;

    // --- Load store unit
    // These parameters must be a power of two.
    // The size of a load queue
    const CONF_LOAD_QUEUE_ENTRY_NUM : u32 = 16;

    // The size of a store queue
    const CONF_STORE_QUEUE_ENTRY_NUM: u32 = 16;

    // --- Predictors
    // Branch predictor
    const CONF_BTB_ENTRY_NUM                  : u32 = 1024;
    const CONF_PHT_ENTRY_NUM                  : u32 = 2048;
    // Global history length for g-share
    const CONF_BRANCH_GLOBAL_HISTORY_BIT_WIDTH: u32 = 10;

    // Memory dependency predictor
    // The number of prediction table entries.
    const CONF_MDT_ENTRY_NUM: u32 = 1024;

    // --- D-cache
    // Total capacity = CONF_DCACHE_WAY_NUM * 2^CONF_DCACHE_INDEX_BIT_WIDTH * CONF_DCACHE_LINE_BYTE_NUM
    // The number of ways in a single set
    // This parameter must be a power of two. 1 is OK.
    const CONF_DCACHE_WAY_NUM        : u32 = 2;

    // The number of index bits
    const CONF_DCACHE_INDEX_BIT_WIDTH: u32 = 9 - $clog2(CONF_DCACHE_WAY_NUM);

    // Line size. This parameter must be a power of two.
    const CONF_DCACHE_LINE_BYTE_NUM  : u32 = 8;

    // The number of MSHR entries.
    const CONF_DCACHE_MSHR_NUM       : u32 = 2;

    // --- I-cache
    // The number of ways in a single set
    // This parameter must be a power of two. It must be larger than 1.
    const CONF_ICACHE_WAY_NUM        : u32 = 2;

    // The number of index bits
    const CONF_ICACHE_INDEX_BIT_WIDTH: u32 = 9 - $clog2(CONF_ICACHE_WAY_NUM);

    // Line size. This parameter must be a power of two.
    // Line size
    const CONF_ICACHE_LINE_BYTE_NUM  : u32 = 8;
}
