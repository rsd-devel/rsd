package StoreCommitterFunctions {
    import BasicTypes::*;
    import CacheSystemTypes::*;
    import LoadStoreUnitTypes::*;

    function GenerateDCacheWriteEnable (
        wordWE   : input LSQ_BlockWordEnablePath,
        byteWE   : input LSQ_WordByteEnablePath,
        blockAddr: input LSQ_BlockAddrPath,
    ) -> DCacheByteEnablePath {
        var ret: DCacheByteEnablePath;
        ret = '0;
        for i in 0..LSQ_BLOCK_WORD_WIDTH {
            if wordWE[i] {
                ret = ret | (byteWE << (i * DATA_BYTE_WIDTH));
            }
        }
        ret = ret << (
            LSQ_BLOCK_BYTE_WIDTH *
            LSQ_SelectBits(blockAddr, 0, DCACHE_LINE_BYTE_NUM_BIT_WIDTH - LSQ_BLOCK_BYTE_WIDTH_BIT_SIZE)
        );
        return ret;
    }

    function GenerateDCacheLine (
        data: input LSQ_BlockDataPath,
    ) -> DCacheLinePath {
        var line: DCacheLinePath;
        line = '0;
        for i in 0..(DCACHE_LINE_BYTE_NUM / LSQ_BLOCK_BYTE_WIDTH) {
            line = line | (data << (i * LSQ_BLOCK_WIDTH));
        }
        return line;
    }
}

module StoreCommitter (
    port       : modport LoadStoreUnitIF::StoreCommitter,
    recovery   : modport RecoveryManagerIF::StoreCommitter,
    ioUnit     : modport IO_UnitIF::StoreCommitter,
    debug      : modport DebugIF::StoreCommitter,
    perfCounter: modport PerformanceCounterIF::StoreCommitter,
) {
    import BasicTypes::*;
    import CacheSystemTypes::*;
    import OpFormatTypes::*;
    import LoadStoreUnitTypes::*;
    import MemoryMapTypes::*;
    import DebugTypes::*;
    import StoreCommitterFunctions::*;

    enum Phase: logic {
        PHASE_COMMIT = 0,
        PHASE_RECOVER = 1,
    }

    var phase: Phase;
    var nextPhase: Phase;

    var unfinishedStoreNum: StoreQueueCountPath;
    var nextUnfinishedStoreNum: StoreQueueCountPath;

    always_ff (port.clk) {
        if port.rst {
            phase = Phase::PHASE_COMMIT;
            unfinishedStoreNum = '0;
        } else {
            phase = nextPhase;
            unfinishedStoreNum = nextUnfinishedStoreNum;
        }
    }

    always_comb {
        if port.rst {
            nextPhase = Phase::PHASE_COMMIT;
        } else if recovery.toRecoveryPhase {
            nextPhase = Phase::PHASE_RECOVER;
        } else if phase == Phase::PHASE_RECOVER {
            nextPhase = Phase::PHASE_COMMIT;
        } else {
            nextPhase = phase;
        }
    }

    var portMSHRPhase: MSHR_Phase [MSHR_NUM];
    var portStoreHasAllocatedMSHR: logic;
    var portStoreMSHRID: MSHR_IndexPath;

    always_comb {
        for i in 0..MSHR_NUM {
            portMSHRPhase[i] = port.mshrPhase[i];
        }
        portStoreHasAllocatedMSHR = port.storeHasAllocatedMSHR[0];
        portStoreMSHRID = port.storeMSHRID[0];
    }

    var stallStoreTagStage: logic;

    struct StgReg {
        valid       : logic,
        condEnabled : logic,
        data        : LSQ_BlockDataPath,
        blockAddr   : LSQ_BlockAddrPath,
        wordWE      : LSQ_BlockWordEnablePath,
        byteWE      : LSQ_WordByteEnablePath,
        isIO        : logic,
        isUncachable: logic,
    }

    var tagStagePipeReg: StgReg;
    var nextTagStagePipeReg: StgReg;
    var dataStagePipeReg: StgReg;
    var nextDataStagePipeReg: StgReg;
    var headStoreHasAllocatedMSHRPipeReg: logic;
    var storeMSHRID: MSHR_IndexPath;

    always_ff (port.clk) {
        if port.rst {
            tagStagePipeReg = '0;
            dataStagePipeReg = '0;
            headStoreHasAllocatedMSHRPipeReg = FALSE;
            storeMSHRID = '0;
        } else {
            if !stallStoreTagStage {
                tagStagePipeReg = nextTagStagePipeReg;
            }
            dataStagePipeReg = nextDataStagePipeReg;

            if !stallStoreTagStage {
                headStoreHasAllocatedMSHRPipeReg = FALSE;
            } else if !headStoreHasAllocatedMSHRPipeReg {
                headStoreHasAllocatedMSHRPipeReg = portStoreHasAllocatedMSHR;
            }

            if portStoreHasAllocatedMSHR {
                storeMSHRID = portStoreMSHRID;
            }
        }
    }

    var dcWriteReq: logic;
    var dcWriteAddr: PhyAddrPath;
    var dcWriteData: DCacheLinePath;
    var dcWriteUncachable: logic;
    var isIO: logic;
    var dcWriteByteWE: DCacheByteEnablePath;
    var isUncachable: logic;
    var retiredStoreQueuePtr: StoreQueueIndexPath;
    var tagStageOffset: StoreQueueIndexPath;
    var dataStageOffset: StoreQueueIndexPath;

    always_comb {
        if tagStagePipeReg.valid {
            tagStageOffset = 1;
        } else {
            tagStageOffset = 0;
        }
        if dataStagePipeReg.valid {
            dataStageOffset = 1;
        } else {
            dataStageOffset = 0;
        }

        retiredStoreQueuePtr =
            port.storeQueueHeadPtr +
            tagStageOffset +
            dataStageOffset;
        if retiredStoreQueuePtr >= STORE_QUEUE_ENTRY_NUM {
            retiredStoreQueuePtr = retiredStoreQueuePtr - STORE_QUEUE_ENTRY_NUM;
        }

        port.retiredStoreQueuePtr = retiredStoreQueuePtr;

        nextUnfinishedStoreNum = unfinishedStoreNum;
        if port.commitStore {
            nextUnfinishedStoreNum = nextUnfinishedStoreNum + port.commitStoreNum;
        }

        isIO =
            IsPhyAddrIO(
                LSQ_ToFullPhyAddrFromBlockAddrAndWordWE(
                    port.retiredStoreLSQ_BlockAddr,
                    port.retiredStoreWordWE
                )
            );

        isUncachable =
            IsPhyAddrUncachable(
                LSQ_ToFullPhyAddrFromBlockAddrAndWordWE(
                    port.retiredStoreLSQ_BlockAddr,
                    port.retiredStoreWordWE
                )
            );

        port.busyInRecovery = phase == Phase::PHASE_RECOVER;

        if unfinishedStoreNum == 0 {
            nextTagStagePipeReg = '0;
            nextTagStagePipeReg.valid = FALSE;
            dcWriteReq = FALSE;
        } else {
            nextTagStagePipeReg.isIO = isIO;
            nextTagStagePipeReg.isUncachable = isUncachable;

            if !port.retiredStoreCondEnabled || isIO {
                dcWriteReq = FALSE;
                nextTagStagePipeReg.valid = TRUE;
            } else {
                dcWriteReq = !stallStoreTagStage;
                nextTagStagePipeReg.valid = port.dcWriteReqAck;
            }

            nextTagStagePipeReg.condEnabled = port.retiredStoreCondEnabled;
            nextTagStagePipeReg.blockAddr = port.retiredStoreLSQ_BlockAddr;
            nextTagStagePipeReg.data = port.retiredStoreData;
            nextTagStagePipeReg.wordWE = port.retiredStoreWordWE;
            nextTagStagePipeReg.byteWE = port.retiredStoreByteWE;

            if !stallStoreTagStage && nextTagStagePipeReg.valid {
                nextUnfinishedStoreNum = nextUnfinishedStoreNum - 1;
            }
        }

        if stallStoreTagStage {
            if headStoreHasAllocatedMSHRPipeReg {
                dcWriteReq = FALSE;
            } else {
                dcWriteReq = tagStagePipeReg.condEnabled;
            }

            dcWriteAddr = LSQ_ToFullAddrFromBlockAddr(tagStagePipeReg.blockAddr);
            dcWriteData = GenerateDCacheLine(tagStagePipeReg.data);
            dcWriteByteWE =
                GenerateDCacheWriteEnable(
                    tagStagePipeReg.wordWE,
                    tagStagePipeReg.byteWE,
                    tagStagePipeReg.blockAddr
                );
            dcWriteUncachable = tagStagePipeReg.isUncachable;
        } else {
            dcWriteAddr = LSQ_ToFullAddrFromBlockAddr(port.retiredStoreLSQ_BlockAddr);
            dcWriteData = GenerateDCacheLine(port.retiredStoreData);
            dcWriteByteWE =
                GenerateDCacheWriteEnable(
                    port.retiredStoreWordWE,
                    port.retiredStoreByteWE,
                    port.retiredStoreLSQ_BlockAddr
                );
            dcWriteUncachable = isUncachable;
        }

        port.dcWriteReq = dcWriteReq;
        port.dcWriteData = dcWriteData;
        port.dcWriteByteWE = dcWriteByteWE;
        port.dcWriteAddr = dcWriteAddr;
        port.dcWriteUncachable = dcWriteUncachable;
    }

    var finishWriteBack: logic;

    always_comb {
        finishWriteBack = FALSE;
        if tagStagePipeReg.valid {
            if !tagStagePipeReg.condEnabled || tagStagePipeReg.isIO {
                stallStoreTagStage = FALSE;
            } else if headStoreHasAllocatedMSHRPipeReg {
                if portMSHRPhase[storeMSHRID] >: MSHR_PHASE_MISS_WRITE_CACHE_REQUEST {
                    stallStoreTagStage = FALSE;
                    finishWriteBack = TRUE;
                } else {
                    stallStoreTagStage = TRUE;
                }
            } else {
                stallStoreTagStage = !port.dcWriteHit;
            }
        } else {
            stallStoreTagStage = FALSE;
        }

        nextDataStagePipeReg = tagStagePipeReg;
        if stallStoreTagStage {
            nextDataStagePipeReg.valid = FALSE;
        }

        for i in 0..STORE_ISSUE_WIDTH {
            if i == 0 {
                perfCounter.storeMiss[i] = finishWriteBack;
            } else {
                perfCounter.storeMiss[i] = FALSE;
            }
        }
    }

    var releaseStoreQueueHead: logic;
    var releaseStoreQueueHeadEntryNum: CommitLaneCountPath;

    always_comb {
        ioUnit.ioWE = FALSE;
        ioUnit.ioWriteDataIn =
            LSQ_ToScalarWordDataFromBlockData(dataStagePipeReg.data, dataStagePipeReg.wordWE);
        ioUnit.ioWriteAddrIn =
            LSQ_ToFullPhyAddrFromBlockAddrAndWordWE(dataStagePipeReg.blockAddr, dataStagePipeReg.wordWE);
        if dataStagePipeReg.valid {
            releaseStoreQueueHeadEntryNum = 1;
            releaseStoreQueueHead = TRUE;
            if dataStagePipeReg.condEnabled && dataStagePipeReg.isIO {
                ioUnit.ioWE = TRUE;
            }
        } else {
            releaseStoreQueueHeadEntryNum = 0;
            releaseStoreQueueHead = FALSE;
        }

        port.releaseStoreQueueHeadEntryNum = releaseStoreQueueHeadEntryNum;
        port.releaseStoreQueueHead = releaseStoreQueueHead;
    }

    always_comb {
        debug.loadStoreUnitAllocatable = port.allocatable;
        debug.storeCommitterPhase = phase;
        debug.storeQueueCount = port.storeQueueCount;
        debug.busyInRecovery = port.busyInRecovery;
        debug.storeQueueEmpty = port.storeQueueEmpty;
    }

    // NOT_TRANSPILED_TO_VERYL
    // `RSD_ASSERT_CLK(port.clk, port.rst || (unfinishedStoreNum <= STORE_QUEUE_ENTRY_NUM), "Committed store num is larger than store queue entry num.")

    // NOT_TRANSPILED_TO_VERYL
    // `RSD_ASSERT_CLK(port.clk, port.rst || !(phase == PHASE_RECOVER && port.commitStore && port.commitStoreNum > 0), "Stores are committed in recovery phase.")
}
