//
// --- Bypass network
//
module BypassNetwork (
    port: modport BypassNetworkIF::BypassNetwork,
    ctrl: modport ControllerIF::BypassNetwork,
) {
    import BasicTypes::*;
    import PipelineTypes::*;
    import BypassTypes::*;

    var intEX: PRegDataPath [INT_ISSUE_WIDTH];
    var intWB: PRegDataPath [INT_ISSUE_WIDTH];
    var memMA: PRegDataPath [MEM_ISSUE_WIDTH];
    var memWB: PRegDataPath [MEM_ISSUE_WIDTH];

    function SelectData (
        sel  : input BypassSelect,
    ) -> PRegDataPath {
        if sel.stg == BYPASS_STAGE_INT_EX {
            return intEX[sel.lane.intLane];
        } else if sel.stg == BYPASS_STAGE_INT_WB {
            return intWB[sel.lane.intLane];
        } else if sel.stg == BYPASS_STAGE_MEM_MA {
            return memMA[sel.lane.memLane];
        } else if sel.stg == BYPASS_STAGE_MEM_WB {
            return memWB[sel.lane.memLane];
        } else {
            return '0;
        }
    }

    always_ff (port.clk) {  // synchronous rst
        for i in 0..INT_ISSUE_WIDTH {
            if port.rst || ctrl.backEnd.clear {  // rst
                intEX[i].data = 0;
                intEX[i].valid = 0;
                intWB[i].data = 0;
                intWB[i].valid = 0;
            } else if ctrl.backEnd.stall {
                // write data
                intEX[i] = intEX[i];
                intWB[i] = intWB[i];
            } else {
                intEX[i] = port.intDstRegDataOut[i];
                intWB[i] = intEX[i];
            }
        }

        for i in 0..MEM_ISSUE_WIDTH {
            if port.rst || ctrl.backEnd.clear {  // rst
                memMA[i].data = 0;
                memMA[i].valid = 0;
                memWB[i].data = 0;
                memWB[i].valid = 0;
            } else if ctrl.backEnd.stall {
                // write data
                memMA[i] = memMA[i];
                memWB[i] = memWB[i];
            } else {
                memMA[i] = port.memDstRegDataOut[i];
                memWB[i] = memMA[i];
            }
        }
    }

    always_comb {
        for i in 0..INT_ISSUE_WIDTH {
            port.intSrcRegDataOutA[i] = SelectData(port.intCtrlIn[i].rA);
            port.intSrcRegDataOutB[i] = SelectData(port.intCtrlIn[i].rB);
        }

        for i in 0..COMPLEX_ISSUE_WIDTH {
            port.complexSrcRegDataOutA[i] = SelectData(port.complexCtrlIn[i].rA);
            port.complexSrcRegDataOutB[i] = SelectData(port.complexCtrlIn[i].rB);
        }

        for i in 0..MEM_ISSUE_WIDTH {
            port.memSrcRegDataOutA[i] = SelectData(port.memCtrlIn[i].rA);
            port.memSrcRegDataOutB[i] = SelectData(port.memCtrlIn[i].rB);
        }

        for i in 0..FP_ISSUE_WIDTH {
            port.fpSrcRegDataOutA[i] = SelectData(port.fpCtrlIn[i].rA);
            port.fpSrcRegDataOutB[i] = SelectData(port.fpCtrlIn[i].rB);
            port.fpSrcRegDataOutC[i] = SelectData(port.fpCtrlIn[i].rC);
        }
    }
}
